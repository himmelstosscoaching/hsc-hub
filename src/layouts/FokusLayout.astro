---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}
const {
  title = 'Annette & Herbert Himmelstoß — Coaches für ein lebendiges Leben',
  description = 'Online-Kurse, Retreats und Begleitung mit Annette & Herbert Himmelstoß. Seit 1992 ein Paar, seit über 30 Jahren begleiten wir Menschen — als Ärztin, Lehrer, Coaches.',
  canonical = 'https://himmelstosscoaching.de/',
  ogImage = '/img/og-default.jpg',
  noindex = false,
} = Astro.props;

import '../styles/brand-v02.css';

// JSON-LD strukturierte Daten — Organization + Person ×2 + Book + WebSite
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Himmelstoß Coaching',
  'url': 'https://himmelstosscoaching.de/',
  'logo': 'https://himmelstosscoaching.de/img/logo.svg',
  'founder': [
    { '@type': 'Person', 'name': 'Annette Himmelstoß' },
    { '@type': 'Person', 'name': 'Herbert Himmelstoß' },
  ],
  'sameAs': [
    'https://www.facebook.com/profile.php?id=100072016483607',
  ],
  'description': description,
};

const annetteSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  'name': 'Annette Himmelstoß',
  'jobTitle': 'Coach für Authentizität und innere Klarheit',
  'description': '24 Jahre Ärztin mit Privatpraxis, seit November 2021 Coach. Begleitet Menschen, bei denen Schulmedizin nicht weiterkam.',
  'knowsAbout': ['Lebenscoaching', 'Authentizität', 'Innere Klarheit', 'Paar-Coaching'],
  'worksFor': { '@type': 'Organization', 'name': 'Himmelstoß Coaching' },
};

const herbertSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  'name': 'Herbert Himmelstoß',
  'jobTitle': 'Diplom-Kunsttherapeut, Waldorflehrer und Coach',
  'description': 'Diplom-Kunsttherapeut und Waldorflehrer. Seit 2008 selbstständig, Spezialist für Sucht- und Drogenprävention sowie Persönlichkeitsentwicklung.',
  'knowsAbout': ['Persönlichkeitsentwicklung', 'Suchtprävention', 'Paar-Coaching', 'Kunsttherapie'],
  'worksFor': { '@type': 'Organization', 'name': 'Himmelstoß Coaching' },
};

const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  'name': 'Trau keinem, der nicht in einer glücklichen Beziehung ist — die Macht zu bekommen, was beide wollen',
  'author': [
    { '@type': 'Person', 'name': 'Annette Himmelstoß' },
    { '@type': 'Person', 'name': 'Herbert Himmelstoß' },
  ],
  'inLanguage': 'de',
  'bookFormat': 'https://schema.org/Paperback',
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'Himmelstoß Coaching',
  'url': 'https://himmelstosscoaching.de/',
  'inLanguage': 'de-DE',
};
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Himmelstoß Coaching" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, canonical).href} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, canonical).href} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />

  <!-- Performance: preconnect zu Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Theme-Color (Browser-Chrome auf Mobile) -->
  <meta name="theme-color" content="#FBF6EE" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#2C4B7B" media="(prefers-color-scheme: dark)" />

  <!-- Strukturierte Daten -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(annetteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(herbertSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(bookSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
</head>
<body>
  <!-- Skip-Link für Tastatur-Navigation -->
  <a href="#main" class="skip-link">Zum Inhalt</a>

  <main id="main">
    <slot />
  </main>

  <a
    href="/angebote"
    class="sticky-cta-fokus"
    id="sticky-cta-fokus"
    aria-label="Angebote ansehen"
  >
    Angebote ansehen →
  </a>

  <script>
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal-on-scroll').forEach(el => io.observe(el));
    }

    const sticky = document.getElementById('sticky-cta-fokus');
    const hero = document.querySelector('.hero-fokus');
    const final = document.querySelector('.final-fokus');
    if (sticky && hero) {
      const heroIo = new IntersectionObserver(([e]) => {
        sticky.classList.toggle('show', !e.isIntersecting);
      }, { threshold: 0 });
      heroIo.observe(hero);
      if (final) {
        const finalIo = new IntersectionObserver(([e]) => {
          if (e.isIntersecting) sticky.classList.remove('show');
        }, { threshold: 0.3 });
        finalIo.observe(final);
      }
    }
  </script>
</body>
</html>

<style is:global>
  /* Skip-Link — sichtbar nur bei Tastatur-Fokus */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 16px;
    z-index: 9999;
    padding: 12px 20px;
    background: var(--blue-deep);
    color: #fff !important;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 14px;
    text-decoration: none;
    transition: top .25s var(--ease);
  }
  .skip-link:focus {
    top: 16px;
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }

  /* Smooth-Scroll Anker-Padding (damit Sticky-Header nicht verdeckt) */
  html { scroll-padding-top: 88px; }

  /* Focus-Visible — sichtbare Tastatur-Indikatoren */
  :focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .btn:focus-visible { outline-offset: 4px; }

  /* Sticky Mobile CTA */
  .sticky-cta-fokus {
    position: fixed;
    bottom: 16px;
    left: 16px;
    right: 16px;
    z-index: 999;
    display: none;
    text-align: center;
    padding: 17px 20px;
    background: var(--orange);
    color: #fff !important;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.03em;
    text-decoration: none;
    border-radius: var(--radius-pill);
    box-shadow: 0 12px 32px rgba(250, 157, 86, 0.35);
    transform: translateY(140%);
    transition: transform .4s var(--ease);
    min-height: 48px;
  }
  .sticky-cta-fokus.show { transform: translateY(0); }
  @media (max-width: 820px) { .sticky-cta-fokus { display: block; } }
</style>
