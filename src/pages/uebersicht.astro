---
// Seiten-Übersicht — interne Landkarte aller Seiten dieser Website.
// Liest AUTOMATISCH alle .astro-Seiten aus src/pages/ aus (import.meta.glob),
// sodass neue Seiten von selbst hier auftauchen. Kopier-Button je Seite.
// noindex, damit die Übersicht nicht bei Google landet.

const files = Object.keys(import.meta.glob('./*.astro'));

// Klartext-Name, Gruppe, Rolle im Ablauf und Position je Slug.
// Gruppiert nach FUNNEL — jede Strecke in der Reihenfolge, die ein Interessent
// durchläuft. So sieht man auf einen Blick, ob eine Strecke vollständig ist.
// Fehlt ein Slug hier, landet die Seite unter „Noch nicht einsortiert“ (mit
// Dateinamen) — das ist der Hinweis, diese Tabelle zu ergänzen.
type Meta = { label: string; group: string; rolle?: string; nr?: number };

const G = {
  haupt:     'Hauptseiten',
  verkauf:   'Verkaufsseiten (ohne eigene Strecke)',
  dlll:      'Strecke · Dein Leben lesen lernen',
  schatz:    'Strecke · Schatz, coachst du mich?',
  hn:        'Strecke · 12 heilige Nächte',
  pfad:      'Strecke · Achtgliedriger Pfad',
  sonntag:   'Strecke · Sonntagsgespräch',
  newsletter:'Strecke · Newsletter',
  recht:     'Rechtliches',
  intern:    'Intern / Entwürfe',
};

const meta: Record<string, Meta> = {
  // ── Hauptseiten ───────────────────────────────────────────────
  'index':                        { label: 'Startseite',                     group: G.haupt, nr: 1 },
  'angebote':                     { label: 'Angebote — alle Kernangebote',   group: G.haupt, nr: 2 },
  'buch':                         { label: 'Das Buch',                       group: G.haupt, nr: 3 },
  'orientierungsgespraech':       { label: 'Orientierungsgespräch',          group: G.haupt, rolle: 'kostenfrei, 30 Min.', nr: 4 },

  // ── Verkaufsseiten ohne eigene Funnel-Strecke ─────────────────
  'einzelcoaching':               { label: 'Einzel-Coaching',                group: G.verkauf, nr: 1 },
  'intensiv-coaching-vogesen':    { label: 'Intensiv-Woche Vogesen',         group: G.verkauf, rolle: 'aktuell beworben', nr: 2 },
  'intensiv-coaching-zypern':     { label: 'Intensiv-Woche Zypern',          group: G.verkauf, rolle: 'ruht, ab Januar',  nr: 3 },
  'monatsausrichtung':            { label: 'Monatsausrichtung',              group: G.verkauf, nr: 4 },
  '12-meditationen':              { label: '12 Meditationen',                group: G.verkauf, nr: 5 },

  // ── Dein Leben lesen lernen ───────────────────────────────────
  'dein-leben-lesen-lernen':          { label: 'DLLL Basic (197 €)',         group: G.dlll, rolle: 'Verkaufsseite', nr: 1 },
  'dein-leben-lesen-lernen-intensiv': { label: 'DLLL Intensiv (697 €)',      group: G.dlll, rolle: 'Verkaufsseite', nr: 2 },

  // ── Schatz / 3-Tage-Challenge ─────────────────────────────────
  '3-tage':                       { label: '3-Tage-Challenge',               group: G.schatz, rolle: 'Opt-in',       nr: 1 },
  '3-tage-fast-dabei':            { label: 'Fast dabei',                     group: G.schatz, rolle: 'Bestätigung',  nr: 2 },
  '3-tage-danke':                 { label: 'Workbook-Download',              group: G.schatz, rolle: 'nach Opt-in',  nr: 3 },
  'schatz':                       { label: 'Schatz, coachst du mich?',       group: G.schatz, rolle: 'Verkaufsseite', nr: 4 },

  // ── 12 heilige Nächte ─────────────────────────────────────────
  '12-heilige-naechte':                     { label: '12 heilige Nächte',    group: G.hn, rolle: 'Verkaufsseite',  nr: 1 },
  '12-heilige-naechte-webinar':             { label: 'Webinar-Anmeldung',    group: G.hn, rolle: 'Opt-in',         nr: 2 },
  '12-heilige-naechte-webinar-fast-dabei':  { label: 'Fast dabei',           group: G.hn, rolle: 'Bestätigung',    nr: 3 },
  '12-heilige-naechte-webinar-danke':       { label: 'Anmeldung bestätigt',  group: G.hn, rolle: 'nach Opt-in',    nr: 4 },
  '12-heilige-naechte-webinar-aufzeichnung':{ label: 'Webinar-Aufzeichnung', group: G.hn, rolle: 'nach dem Termin', nr: 5 },

  // ── Achtgliedriger Pfad ───────────────────────────────────────
  'achtgliedriger-pfad':            { label: 'Achtgliedriger Pfad',          group: G.pfad, rolle: 'Verkaufsseite', nr: 1 },
  'achtgliedriger-pfad-optin':      { label: 'Anmeldung',                    group: G.pfad, rolle: 'Opt-in',        nr: 2 },
  'achtgliedriger-pfad-fast-dabei': { label: 'Fast dabei',                   group: G.pfad, rolle: 'Bestätigung',   nr: 3 },
  'achtgliedriger-pfad-danke':      { label: 'Danke',                        group: G.pfad, rolle: 'nach Opt-in',   nr: 4 },
  'achtgliedriger-pfad-willkommen': { label: 'Willkommen',                   group: G.pfad, rolle: 'nach dem Kauf', nr: 5 },

  // ── Sonntagsgespräch ──────────────────────────────────────────
  'sonntagsgespraech':             { label: 'Sonntagsgespräch',              group: G.sonntag, rolle: 'Opt-in',       nr: 1 },
  'sonntagsgespraech-fast-dabei':  { label: 'Fast dabei',                    group: G.sonntag, rolle: 'Bestätigung',  nr: 2 },
  'sonntagsgespraech-bestaetigt':  { label: 'Anmeldung bestätigt',           group: G.sonntag, rolle: 'nach Opt-in',  nr: 3 },
  'sonntagsgespraech-willkommen':  { label: 'Willkommen',                    group: G.sonntag, rolle: 'aus der Mail', nr: 4 },

  // ── Newsletter ────────────────────────────────────────────────
  'newsletter-bestaetigen':       { label: 'Bitte bestätigen',               group: G.newsletter, rolle: 'Bestätigung', nr: 1 },
  'newsletter-willkommen':        { label: 'Willkommen',                     group: G.newsletter, rolle: 'nach Opt-in', nr: 2 },

  // ── Rechtliches / Intern ──────────────────────────────────────
  'impressum':                    { label: 'Impressum',                      group: G.recht, nr: 1 },
  'datenschutz':                  { label: 'Datenschutz',                    group: G.recht, nr: 2 },
  'fokus':                        { label: 'Fokus (Layout-Variante)',        group: G.intern, nr: 1 },
  'fokus2b':                      { label: 'Fokus 2b (Layout-Variante)',     group: G.intern, nr: 2 },
};

const groupOrder = [
  G.haupt, G.verkauf, G.dlll, G.schatz, G.hn, G.pfad, G.sonntag,
  G.newsletter, G.recht, G.intern, 'Noch nicht einsortiert',
];

type Page = { slug: string; path: string; label: string; group: string; rolle?: string; nr: number };

const pages: Page[] = files
  .map((f) => f.replace('./', '').replace('.astro', ''))
  .filter((slug) => slug !== 'uebersicht') // sich selbst nicht listen
  .map((slug) => {
    const m = meta[slug];
    return {
      slug,
      path: slug === 'index' ? '/' : `/${slug}`,
      label: m?.label ?? slug,
      group: m?.group ?? 'Noch nicht einsortiert',
      rolle: m?.rolle,
      nr: m?.nr ?? 99,
    };
  })
  // Innerhalb einer Strecke nach Ablauf sortieren, nicht alphabetisch.
  .sort((a, b) => (a.nr - b.nr) || a.label.localeCompare(b.label, 'de'));

const grouped = groupOrder
  .map((g) => ({ group: g, items: pages.filter((p) => p.group === g) }))
  .filter((g) => g.items.length > 0);

const total = pages.length;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Seiten-Übersicht — Himmelstoß Coaching</title>
    <style>
      :root {
        --blue: #186996;
        --blue-light: #2783ac;
        --ink: #1f2a30;
        --muted: #6b7a82;
        --line: #e3e9ec;
        --bg: #f6f8f9;
        --card: #ffffff;
        --ok: #2e8b57;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.5;
      }
      .wrap { max-width: 860px; margin: 0 auto; padding: 40px 20px 80px; }
      header h1 { font-size: 1.9rem; margin: 0 0 6px; }
      header p { color: var(--muted); margin: 0 0 4px; }
      .count { font-size: 0.85rem; color: var(--muted); }
      .group { margin-top: 34px; }
      .group h2 {
        font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--blue); margin: 0 0 12px; padding-bottom: 6px;
        border-bottom: 2px solid var(--line);
      }
      .row {
        display: flex; align-items: center; gap: 12px;
        background: var(--card); border: 1px solid var(--line);
        border-radius: 12px; padding: 12px 14px; margin-bottom: 10px;
      }
      .row .info { flex: 1 1 auto; min-width: 0; }
      .row .label { font-weight: 600; }
      /* Rolle im Ablauf — dezent, damit der Seitenname fuehrend bleibt */
      .row .rolle {
        display: inline-block;
        margin-left: 9px;
        padding: 2px 8px;
        border-radius: 10px;
        background: #eef3f6;
        color: var(--muted);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: .02em;
        vertical-align: 1px;
        white-space: nowrap;
      }
      .row a.url {
        display: inline-block; font-size: 0.85rem; color: var(--blue-light);
        text-decoration: none; word-break: break-all;
      }
      .row a.url:hover { text-decoration: underline; }
      .actions { display: flex; gap: 8px; flex: 0 0 auto; }
      .btn {
        border: 1px solid var(--line); background: #fff; color: var(--ink);
        border-radius: 8px; padding: 8px 12px; font-size: 0.85rem; cursor: pointer;
        white-space: nowrap; transition: background 0.15s, border-color 0.15s;
      }
      .btn:hover { background: #f0f4f6; border-color: var(--blue-light); }
      .btn.open { text-decoration: none; color: var(--blue); display: inline-flex; align-items: center; }
      .btn.copied { background: var(--ok); border-color: var(--ok); color: #fff; }
      footer { margin-top: 44px; font-size: 0.8rem; color: var(--muted); }
      @media (max-width: 560px) {
        .row { flex-wrap: wrap; }
        .actions { width: 100%; }
        .btn { flex: 1 1 0; text-align: center; justify-content: center; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <h1>Seiten-Übersicht</h1>
        <p>Alle Seiten dieser Website — mit Direktlink und Kopier-Button.</p>
        <p class="count">{total} Seiten · aktualisiert sich automatisch bei neuen Seiten</p>
      </header>

      {grouped.map((g) => (
        <section class="group">
          <h2>{g.group}</h2>
          {g.items.map((p) => (
            <div class="row">
              <div class="info">
                <div class="label">{p.label}{p.rolle && <span class="rolle">{p.rolle}</span>}</div>
                <a class="url" href={p.path} data-path={p.path}>{p.path}</a>
              </div>
              <div class="actions">
                <a class="btn open" href={p.path} target="_blank" rel="noopener">Öffnen ↗</a>
                <button class="btn copy" type="button" data-path={p.path}>Link kopieren</button>
              </div>
            </div>
          ))}
        </section>
      ))}

      <footer>
        Interne Übersicht · nicht bei Google gelistet (noindex).
      </footer>
    </div>

    <script is:inline>
      (function () {
        var origin = window.location.origin;
        // Angezeigte Links auf volle URL setzen (rename-sicher)
        document.querySelectorAll('a.url').forEach(function (a) {
          var path = a.getAttribute('data-path');
          a.textContent = origin + path;
        });
        // Kopier-Buttons
        document.querySelectorAll('button.copy').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var url = origin + btn.getAttribute('data-path');
            var done = function () {
              var old = btn.textContent;
              btn.textContent = 'Kopiert ✓';
              btn.classList.add('copied');
              setTimeout(function () { btn.textContent = old; btn.classList.remove('copied'); }, 1600);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(url).then(done).catch(function () { fallback(url); done(); });
            } else { fallback(url); done(); }
          });
        });
        function fallback(text) {
          var ta = document.createElement('textarea');
          ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
        }
      })();
    </script>
  </body>
</html>
