---
import FokusLayout from '../layouts/FokusLayout.astro';
import HeaderFokus from '../components/HeaderFokus.astro';
import FooterFokus from '../components/FooterFokus.astro';
import FormatBadge from '../components/FormatBadge.astro';
import PhotoBand from '../components/PhotoBand.astro';
import PathFinder from '../components/PathFinder.astro';
import { kern, weitere, kostenlos } from '../data/angebote';

// Einzelcoaching wird als volle-Breite-Kachel mit 3 Wegen gezeigt → aus dem 2-Spalten-Raster lösen.
const kernGrid = kern.filter((a) => a.id !== 'einzelcoaching');

// ── Einzelcoaching · volle-Breite-Kachel mit 3 Wegen ──
// Warme Kurz-Vorschau; jeder Button springt auf das passende Angebot der Salespage /einzelcoaching.
// Preise final (Annette 2026-07-02): Allein 770 € · Zu zweit 1.370 € · Mit Tier 890 €
const ecWege = [
  {
    tag: 'Allein',
    variante: 'is-allein',
    titel: 'Mit Herbert oder Annette',
    nutzen: 'Ihr löst ein tiefliegendes Muster auf, das dir gerade im Weg steht. Du wählst, mit wem du gehst — mit Herbert oder mit Annette.',
    format: '3 Doppeltermine · 6 Sessions',
    preis: '770 €',
    url: '/einzelcoaching#allein',
    foto: null,
  },
  {
    tag: 'als Paar',
    variante: 'is-paar',
    titel: 'Mit Herbert und Annette',
    nutzen: 'Ein Thema, das zwischen euch steht — und das ihr zu zweit angeht. Herbert und Annette begleiten euch gemeinsam, mit zwei Blickwinkeln auf das, was euch trennt — um wieder zueinander zu finden.',
    format: '3 Doppeltermine · zu zweit begleitet',
    preis: '1.370 €',
    url: '/einzelcoaching#zu-zweit',
    foto: null,
  },
  {
    tag: 'Mit deinem Tier',
    variante: 'is-tier',
    titel: 'Mit deinem Tier im Gespräch',
    nutzen: 'Dein Tier weiß oft mehr über dich, als dir bewusst ist. Steffi spricht mit ihm — was es zeigt, wird zum Einstieg in deinen Prozess mit Annette.',
    format: '6 Sessions mit Annette + 2 Tiergespräche mit Steffi',
    preis: '890 €',
    url: '/einzelcoaching#mit-tier',
    foto: null,
  },
];
---

<FokusLayout
  title="Angebote — Annette & Herbert Himmelstoß"
  description="Online-Kurse, persönliche Begleitung und Retreats mit Annette & Herbert Himmelstoß. Such dir aus, was zu dir passt — allein oder als Paar."
  canonical="https://himmelstosscoaching.de/angebote"
>
  <HeaderFokus />

  <!-- Hero -->
  <section class="ang-hero">
    <div class="ang-halo" aria-hidden="true"></div>
    <div class="container narrow">
      <p class="acc-eyebrow ang-eyebrow">Unsere Angebote im Überblick</p>
      <h1>Such dir aus, was zu dir passt.</h1>
      <p class="ang-sub">
        Online oder vor Ort. Für dich allein oder als Paar.
        Ein erster kostenloser Schritt — oder tiefe Zeit am Meer.
      </p>
      <p class="ang-frei-hint">Noch nicht sicher? <a href="#frei">Starte mit einem kostenlosen ersten Schritt <span class="arrow">→</span></a></p>
      <!-- Legende: erklärt die drei Format-Zeichen -->
      <div class="ang-legende">
        <FormatBadge type="kurs" />
        <FormatBadge type="live-online" />
        <FormatBadge type="live-vor-ort" />
      </div>
    </div>
  </section>

  <PathFinder />

  <!-- Kernangebote -->
  <section class="ang-kat bg-white pad-b-sm">
    <div class="container">
      <div class="kat-head">
        <span class="kat-label">Unsere 5 Kernangebote</span>
        <p class="kat-intro">Fünf Wege, mit uns zu arbeiten — von zu Hause aus, live über Zoom oder bei uns vor Ort.</p>
      </div>
      <div class="kern-grid">
        {kernGrid.map((a, i) => (
          <article id={a.id} class="ang-card is-highlight reveal-on-scroll">
            <FormatBadge type={a.formatType} />
            <span class="ang-num">{i + 1}</span>
            <h3>{a.name}</h3>
            <p class="ang-nutzen">{a.nutzen}</p>
            <p class="ang-format">{a.format}</p>
            <div class="ang-foot">
              <span class="ang-preis">{a.preis}</span>
              <a href={a.url} class="ang-cta" target={a.url.startsWith('http') ? '_blank' : undefined} rel={a.url.startsWith('http') ? 'noopener' : undefined}>{a.cta} →</a>
            </div>
            {a.note && !a.note.startsWith('⚠️') && <p class="ang-note">{a.note}</p>}
          </article>
        ))}

        {/* ── Einzelcoaching · volle Breite · 3 Wege → springen auf /einzelcoaching ── */}
        <article id="einzelcoaching" class="ang-card is-highlight ec-full reveal-on-scroll">
          <div class="ec-head">
            <FormatBadge type="live-online" />
            <span class="ang-num">5</span>
            <h3>Ein Thema im Einzelcoaching lösen</h3>
            <p class="ang-nutzen">In drei Doppelterminen gehst du einem Thema so weit auf den Grund, bis es sich löst. Du wählst, mit wem du diesen Weg gehst.</p>
          </div>
          <div class="ec-wege">
            {ecWege.map((w) => (
              <a class={`ec-weg ${w.variante}`} href={w.url}>
                {w.foto && (
                  <span class="ec-weg-foto">
                    <img src={w.foto} alt="Stefanie Sophia (Steffi), Tierkommunikatorin" loading="lazy" />
                  </span>
                )}
                <span class="ec-tag">{w.tag}</span>
                <h4>{w.titel}</h4>
                <p class="ec-nutzen">{w.nutzen}</p>
                <p class="ec-format">{w.format}</p>
                <div class="ec-foot">
                  <span class="ec-preis">{w.preis}</span>
                  <span class="ang-cta">Mehr erfahren →</span>
                </div>
              </a>
            ))}
          </div>
        </article>
      </div>
    </div>
  </section>

  <PhotoBand
    image="/img/Q8F_3914.jpg"
    alt="Annette und Herbert im Coaching-Gespräch mit einer Klientin"
    side="left"
    bg="cream"
    compact
    uncropped
    eyebrow="Deine Antwort, nicht unsere"
    quote="„Ich brauche nicht mehr ständig äußere Ratschläge — ich kann mir selbst Antworten geben.“"
    author="Elisabeth S."
  />

  <!-- Weitere & saisonale Angebote -->
  <section class="ang-kat bg-white pad-y-sm">
    <div class="container">
      <div class="kat-head">
        <span class="kat-label">Weitere &amp; saisonale Angebote</span>
        <p class="kat-intro">Dazu kommen Angebote für besondere Zeiten und besondere Anliegen.</p>
      </div>
      <div class="weitere-grid">
        {weitere.map((a) => (
          <article id={a.id} class="ang-card compact reveal-on-scroll">
            <FormatBadge type={a.formatType} />
            <h3>{a.name}</h3>
            <p class="ang-nutzen">{a.nutzen}</p>
            <p class="ang-format">{a.format}</p>
            <div class="ang-foot">
              <span class="ang-preis">{a.preis}</span>
              <a href={a.url} class="ang-cta" target={a.url.startsWith('http') ? '_blank' : undefined} rel={a.url.startsWith('http') ? 'noopener' : undefined}>{a.cta} →</a>
            </div>
            {a.note && !a.note.startsWith('⚠️') && <p class="ang-note">{a.note}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <PhotoBand
    image="/img/annette-herbert-heben.jpg"
    alt="Annette und Herbert lachend am Strand"
    side="right"
    bg="cream"
    compact
    cropTop
    eyebrow="Wissen verändert nichts"
    quote="„Mut ist trainierbar — und verändert mein ganzes Leben.“"
    author="Chris S."
  />

  <!-- Kostenlos reinschnuppern -->
  <section id="frei" class="ang-frei pad-t-sm">
    <div class="container">
      <div class="kat-head center">
        <span class="kat-label">Kostenlos reinschnuppern</span>
        <p class="kat-intro">Du musst dich nicht gleich entscheiden. Lern uns kennen und spür, ob unsere Art zu dir passt.</p>
      </div>
      <div class="frei-grid">
        {kostenlos.map((a) => (
          <article class="frei-card reveal-on-scroll">
            <h3>{a.name}</h3>
            <p>{a.nutzen}</p>
            <span class="frei-format">{a.format}</span>
            <a href={a.url} class="btn-link">{a.cta} <span class="arrow">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Abschluss -->
  <section class="ang-final on-dark">
    <div class="container narrow">
      <h2>Nicht sicher, was zu dir passt?</h2>
      <p>Schreib uns oder frag einen Termin an — wir schauen gemeinsam, was für dich stimmig ist.</p>
      <div class="ang-final-ctas">
        <a href="https://orientierungsgespraech-himmelstoss.youcanbook.me" target="_blank" rel="noopener" class="btn btn-primary">Orientierungsgespräch buchen</a>
        <a href="mailto:kontakt@himmelstosscoaching.de" class="btn btn-secondary">Lieber schreiben?</a>
      </div>
    </div>
  </section>

  <FooterFokus />
</FokusLayout>

<style>
  /* Hero */
  .ang-hero { position: relative; background: var(--bg-white); padding: clamp(90px, 11vw, 140px) 0 0; overflow: hidden; text-align: center; }
  .ang-halo { position: absolute; inset: 0; background: var(--hero-halo); pointer-events: none; }
  .ang-hero .container { position: relative; z-index: 1; padding-bottom: clamp(70px, 9vw, 110px); }
  .ang-hero .acc-eyebrow { justify-content: center; }
  .ang-hero .ang-eyebrow { font-size: clamp(17px, 2vw, 22px); letter-spacing: 0.10em; margin-bottom: 20px; }
  .ang-hero h1 { color: var(--blue-deep); font-size: clamp(34px, 4.4vw, 56px); margin: 0 0 24px; }
  .ang-frei-hint { margin: 18px 0 0; font-size: clamp(15px, 1.3vw, 17px); color: var(--ink-soft); }
  .ang-frei-hint a { color: var(--orange); font-weight: 600; text-decoration: none; border-bottom: 1.5px solid rgba(250,157,86,0.4); padding-bottom: 1px; transition: border-color .25s; }
  .ang-frei-hint a:hover { border-bottom-color: var(--orange); text-decoration: none; }
  .ang-frei-hint .arrow { display: inline-block; transition: transform .25s var(--ease); }
  .ang-frei-hint a:hover .arrow { transform: translateX(3px); }
  .ang-sub { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.65; color: var(--ink-soft); margin: 0 auto; max-width: 640px; }
  .ang-legende { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 28px; }

  /* Sektion */
  .ang-kat { padding: clamp(70px, 9vw, 120px) 0; }
  /* Abschnitte, die an ein Foto-Band grenzen: Abstand zum Band hin verkleinern */
  .ang-kat.pad-b-sm { padding-bottom: clamp(34px, 5vw, 58px); }
  .ang-kat.pad-y-sm { padding-top: clamp(34px, 5vw, 58px); padding-bottom: clamp(34px, 5vw, 58px); }
  .ang-frei.pad-t-sm { padding-top: clamp(34px, 5vw, 58px); }
  .bg-white { background: var(--bg-white); }
  .bg-cream { background: var(--bg-cream); }
  .kat-head { max-width: 640px; margin: 0 0 48px; }
  .kat-head.center { margin-left: auto; margin-right: auto; text-align: center; }
  .kat-label {
    display: inline-block;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(24px, 2.6vw, 34px); color: var(--blue-deep); margin-bottom: 10px;
  }
  .kat-intro { font-size: clamp(16px, 1.4vw, 18px); color: var(--ink-soft); margin: 0; line-height: 1.6; }

  /* Karten-Gitter */
  .kern-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .weitere-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  .ang-card {
    scroll-margin-top: 96px;
    position: relative;
    overflow: hidden;
    background: var(--bg-cream);
    border: 1px solid rgba(250, 157, 86, 0.18);
    border-radius: var(--radius-card);
    padding: 30px 30px;
    display: flex; flex-direction: column; gap: 12px;
    box-shadow: var(--shadow-soft);
    transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s var(--ease);
  }
  .ang-card:hover {
    transform: translateY(-6px) scale(1.012);
    box-shadow: 0 20px 44px rgba(44, 75, 123, 0.14);
    border-color: rgba(250, 157, 86, 0.5);
  }
  /* Alle Angebots-Karten: oberer Streifen als animierter Sun-Strip (durchgängiger Hinweis aufs Angebot) */
  .ang-card::before {
    content: "";
    position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: var(--sun-strip);
    background-size: 200% 100%;
    animation: sun-shimmer 14s ease-in-out infinite;
  }
  /* Kernangebote: dickerer Streifen = mehr Gewicht */
  .ang-card.is-highlight::before { height: 10px; }
  .ang-card h3 { font-family: var(--font-display); font-weight: 700; font-size: 22px; color: var(--blue-deep); margin: 0; }
  .ang-nutzen { font-family: var(--font-display); font-style: italic; font-size: 16px; line-height: 1.5; color: var(--ink-soft); margin: 0; }
  .ang-format { font-size: 13.5px; color: var(--ink-light); margin: 0; letter-spacing: 0.01em; }
  .ang-foot {
    display: flex; justify-content: space-between; align-items: baseline; gap: 10px 14px;
    flex-wrap: wrap;
    margin-top: auto; padding-top: 14px; border-top: 1px solid rgba(250,157,86,0.25);
  }
  .ang-preis { font-family: var(--font-display); font-weight: 700; font-size: 18px; color: var(--blue-deep); }
  .ang-cta {
    font-family: var(--font-body); font-weight: 600; font-size: 13px; letter-spacing: 0.06em;
    color: var(--blue-deep); border-bottom: 1.5px solid var(--blue-deep); padding-bottom: 2px;
    text-decoration: none; transition: color .25s, border-color .25s; white-space: nowrap;
  }
  .ang-cta:hover { color: var(--orange); border-color: var(--orange); text-decoration: none; }
  .ang-note { font-size: 11.5px; color: var(--ink-light); font-style: italic; margin: 0; }

  /* Große Angebots-Nummer vor dem Titel */
  .ang-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 3.6vw, 46px);
    line-height: 1;
    color: var(--orange);
    margin: 8px 0 2px;
  }
  .ec-head .ang-num { margin-top: 0; }

  /* ── Einzelcoaching · volle-Breite-Kachel mit 3 Wegen ── */
  .ec-full {
    grid-column: 1 / -1;      /* spannt über beide Raster-Spalten */
    gap: 26px;
  }
  .ec-head { max-width: 720px; }
  .ec-head h3 { margin-top: 4px; }
  .ec-wege {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    align-items: stretch;
    margin-top: 4px;
  }

  /* Jede Kachel = klickbarer Link auf das passende Angebot der Salespage */
  .ec-weg {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 9px;
    overflow: hidden;
    background: var(--bg-white);
    border: 1px solid rgba(44, 75, 123, 0.14);
    border-top: 3px solid var(--blue-deep);
    border-radius: var(--radius-card);
    padding: 22px 22px;
    text-decoration: none;
    transition: transform .3s var(--ease), box-shadow .3s var(--ease), border-color .3s var(--ease);
  }
  .ec-weg:hover {
    transform: translateY(-6px) scale(1.015);
    box-shadow: 0 18px 40px rgba(44, 75, 123, 0.16);
    text-decoration: none;
  }
  .ec-weg:hover .ang-cta { color: var(--orange); border-color: var(--orange); }
  /* Foto der Tier-Kachel zoomt beim Drüberfahren ganz leicht */
  .ec-weg-foto img { transition: transform .4s var(--ease); }
  .ec-weg:hover .ec-weg-foto img { transform: scale(1.06); }

  /* 3 Wege klar voneinander abheben — je eigener Akzent */
  .ec-weg.is-allein { border-top-color: var(--blue-deep); }
  .ec-weg.is-paar   { border-top-color: var(--rose); }
  .ec-weg.is-tier   { border-top-color: var(--orange); }

  /* Foto (nur Tier-Kachel) — randlos bis an die Kachelkanten oben */
  .ec-weg-foto { display: block; margin: -22px -22px 4px; }
  .ec-weg-foto img { width: 100%; height: 150px; object-fit: cover; display: block; }

  .ec-tag {
    align-self: flex-start;
    font-family: var(--font-body); font-weight: 600; font-size: 11.5px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--blue-deep);
    background: rgba(44, 75, 123, 0.08); border-radius: var(--radius-pill); padding: 5px 12px;
  }
  .ec-weg.is-paar .ec-tag { color: var(--rose); background: rgba(200, 116, 120, 0.12); }
  .ec-weg.is-tier .ec-tag { color: var(--orange); background: rgba(250, 157, 86, 0.12); }

  .ec-weg h4 {
    font-family: var(--font-display); font-weight: 700; font-size: 19px;
    color: var(--blue-deep); margin: 2px 0 0;
  }
  .ec-nutzen {
    font-family: var(--font-display); font-style: italic;
    font-size: 15px; line-height: 1.55; color: var(--ink-soft); margin: 0; flex-grow: 1;
  }
  .ec-format { font-size: 13px; color: var(--ink-light); margin: 0; }
  .ec-foot {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 10px 14px; flex-wrap: wrap;
    margin-top: 6px; padding-top: 14px; border-top: 1px solid rgba(250,157,86,0.25);
  }
  .ec-preis { font-family: var(--font-display); font-weight: 700; font-size: 22px; color: var(--blue-deep); }

  @media (max-width: 820px) {
    .ec-wege { grid-template-columns: 1fr; }
  }

  /* Kompakte Karten (Weitere & saisonal) */
  .ang-card.compact { padding: 24px 24px; gap: 10px; }
  .ang-card.compact h3 { font-size: 19px; }
  .ang-card.compact .ang-nutzen { font-size: 15px; }
  .ang-card.compact .ang-preis { font-size: 16px; }

  /* Kostenlos */
  .ang-frei { background: var(--bg-cream); padding: clamp(70px, 9vw, 120px) 0; }
  .frei-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 1100px; margin: 0 auto; }
  .frei-card {
    background: var(--bg-white); border-radius: var(--radius-card); padding: 32px 28px;
    display: flex; flex-direction: column; gap: 10px; border: 1px solid rgba(250,157,86,0.18);
    position: relative; overflow: hidden;
    transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s var(--ease);
  }
  .frei-card:hover {
    transform: translateY(-6px) scale(1.012);
    box-shadow: 0 20px 44px rgba(44, 75, 123, 0.14);
    border-color: rgba(250, 157, 86, 0.5);
  }
  .frei-card::before { content:""; position:absolute; top:0; left:0; right:0; height:4px; background: var(--sun-strip); background-size: 200% 100%; animation: sun-shimmer 14s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    .ang-card::before, .frei-card::before { animation: none; }
  }
  .frei-card h3 { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--blue-deep); margin: 0; }
  .frei-card p { font-size: 15px; color: var(--ink-soft); line-height: 1.6; margin: 0; flex-grow: 1; }
  .frei-format { font-size: 12.5px; color: var(--ink-light); }
  .frei-card .btn-link { margin-top: 6px; }

  /* Final */
  .ang-final { position: relative; background: var(--sunset-surface); padding: clamp(90px, 11vw, 130px) 0; text-align: center; overflow: hidden; }
  .ang-final::before { content:""; position:absolute; inset:0; background: linear-gradient(180deg, rgba(44,75,123,0.5) 0%, rgba(44,75,123,0) 70%); pointer-events:none; }
  .ang-final .container { position: relative; z-index: 1; }
  .ang-final h2 { color: #fff; margin: 0 0 16px; font-weight: 600; }
  .ang-final p { color: rgba(255,255,255,0.9); font-size: clamp(16px,1.5vw,19px); margin: 0 auto 32px; max-width: 560px; }
  .ang-final-ctas { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 14px; }
  .ang-final .btn-secondary { color: #fff !important; border-color: rgba(255,255,255,0.6); }
  .ang-final .btn-secondary:hover { background: rgba(255,255,255,0.10); border-color: #fff; }
  .ang-final-link { color: rgba(255,255,255,0.85); font-family: var(--font-body); font-weight: 600; font-size: 14px; text-decoration: none; border-bottom: 1.5px solid transparent; padding-bottom: 2px; }
  .ang-final-link:hover { color: #fff; border-bottom-color: rgba(255,255,255,0.6); }
  .ang-final-link .arrow, .frei-card .arrow { display: inline-block; transition: transform .25s var(--ease); }
  .ang-final-link:hover .arrow { transform: translateX(4px); }

  @media (max-width: 980px) {
    .weitere-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 820px) {
    .kern-grid { grid-template-columns: 1fr; }
    .weitere-grid { grid-template-columns: 1fr; }
    .frei-grid { grid-template-columns: 1fr; max-width: 480px; }
  }
</style>
