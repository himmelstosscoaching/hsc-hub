---
import FunnelLayout from '../layouts/FunnelLayout.astro';
import FunnelFooter from '../components/FunnelFooter.astro';
import '../styles/salespage.css';

// Danke-Seite nach dem Kauf der Übungsgruppe (Digistore 758474, Feld „thankyou_url“).
// Zoom- und Telegram-Link stehen bewusst NICHT hier (Seite ist öffentlich erreichbar) — sie kommen mit der
// Willkommensmail aus der Quentn-Kampagne „Der 8-gliedrige Pfad“. Stil wie /achtgliedriger-pfad-optin.
// Projekt-Doku: ../HSC-Achtgliedriger-Pfad/
const PDF_URL = '/downloads/Der-achtgliedrige-Pfad.pdf';

const schritte = [
  ['Postfach öffnen', 'Gerade ist eine Mail an Dich unterwegs, Betreff „Willkommen in der Übungsgruppe – deine Zugänge“. Darin findest Du den Zoom-Zugang für alle neun Treffen. Schau auch im Spam-Ordner nach.'],
  ['Telegram-Gruppe beitreten', 'In derselben Mail steckt die Einladung in unsere Telegram-Gruppe. Dort findest Du nach jedem Treffen die Aufzeichnung.'],
  ['Die Dienstage eintragen', 'Neun Abende, jeweils 19:00 bis 20:30 Uhr. Am besten trägst Du sie Dir gleich alle in den Kalender ein.'],
];
---

<FunnelLayout
  title="Willkommen in der Übungsgruppe — Der achtgliedrige Pfad"
  description="Danke für Deine Buchung der Übungsgruppe zum achtgliedrigen Pfad mit Annette & Herbert Himmelstoß."
  noindex={true}
>
<div class="pw">

<header class="pw-head">
  <img src="/img/logo.svg" alt="Himmelstoß Coaching" />
</header>

<section class="pw-hero">
  <div class="pw-wrap">
    <p class="pw-kicker">Übungsgruppe · Der achtgliedrige Pfad</p>
    <h1>Schön, dass Du dabei bist.<em>Dein Platz ist reserviert.</em></h1>

    <div class="pw-termin">
      <p class="pw-termin-k">Deine 9 Live-Treffen</p>
      <p class="pw-termin-d">12. Januar – 9. März 2027</p>
      <p class="pw-termin-z">dienstags · 19:00–20:30 Uhr · online im Zoom</p>
    </div>
  </div>
</section>

<section class="pw-section">
  <div class="pw-wrap">
    <p class="pw-kicker pw-center">So geht es weiter</p>
    <ol class="pw-steps">
      {schritte.map(([titel, text], i) => (
        <li>
          <span class="pw-num">{i + 1}</span>
          <div>
            <h3>{titel}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="pw-section pw-cream">
  <div class="pw-wrap pw-center">
    <p class="pw-kicker">Bis Januar</p>
    <h2>Fang ruhig schon an.</h2>
    <p class="pw-text">Such Dir eine der acht Übungen aus und nimm sie mit in Deine Woche. In der Gruppe erzählst Du dann, was Du damit erlebt hast.</p>
    <a class="pw-btn" href={PDF_URL} target="_blank" rel="noopener">Die acht Übungen als PDF</a>
    <p class="pw-sig">Wir freuen uns auf Dich.<br /><em>Annette &amp; Herbert</em></p>
  </div>
</section>

<p class="pw-contact">Keine Mail bekommen oder eine Frage? Schreib uns an <a href="mailto:kontakt@himmelstosscoaching.de">kontakt@himmelstosscoaching.de</a>.</p>

</div>
<FunnelFooter />
</FunnelLayout>

<style>
  .pw {
    --navy: #2C4B7B; --blue: #2783ac; --ink: #2A2A2E; --soft: #55555E; --light: #8A8A90;
    --cream: #FBF6EE; --line: #E7DCCB; --accent: #FA9D56;
    font-family: 'League Spartan', Helvetica, Arial, sans-serif; color: var(--ink); -webkit-font-smoothing: antialiased;
  }
  .pw :global(h1), .pw :global(h2), .pw :global(h3) { font-family: 'Fontin', Georgia, serif; color: var(--navy); font-weight: 400; margin: 0; }
  .pw p { margin: 0; }
  .pw-wrap { max-width: 860px; margin: 0 auto; padding: 0 28px; }
  .pw-center { text-align: center; }
  .pw-kicker { font-size: 13px; letter-spacing: .18em; text-transform: uppercase; color: var(--accent); font-weight: 600; margin-bottom: 16px !important; }

  .pw-head { background: #fff; border-bottom: 1px solid var(--line); display: flex; justify-content: center; padding: 18px 0; }
  .pw-head img { height: 48px; width: auto; display: block; }

  .pw-hero { background: var(--cream); padding: 90px 0 96px; text-align: center; border-bottom: 1px solid var(--line); }
  .pw-hero h1 { font-size: clamp(34px, 4.2vw, 52px); line-height: 1.15; }
  .pw-hero h1 em { display: block; font-style: italic; color: var(--blue); font-size: .66em; margin-top: 12px; }
  .pw-termin { display: inline-block; margin-top: 44px; padding: 26px 44px; background: #fff; border: 1px solid var(--line); }
  .pw-termin-k { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--light); font-weight: 600; margin-bottom: 8px !important; }
  .pw-termin-d { font-family: 'Fontin', Georgia, serif; font-size: 26px; color: var(--navy); margin-bottom: 6px !important; }
  .pw-termin-z { font-size: 17px; color: var(--soft); }

  .pw-section { padding: 96px 0; background: #fff; }
  .pw-cream { background: var(--cream); }
  .pw-steps { list-style: none; margin: 34px 0 0; padding: 0; }
  .pw-steps li { display: grid; grid-template-columns: 54px 1fr; gap: 8px; padding: 26px 0; border-top: 1px solid var(--line); }
  .pw-steps li:last-child { border-bottom: 1px solid var(--line); }
  .pw-num { font-family: 'Fontin', Georgia, serif; font-size: 30px; line-height: 1; color: var(--accent); }
  .pw-steps h3 { font-size: 24px; margin-bottom: 8px; }
  .pw-steps p { font-size: 17px; line-height: 1.65; color: var(--soft); }

  .pw-cream h2 { font-size: clamp(28px, 3.2vw, 38px); margin-bottom: 20px; }
  .pw-text { max-width: 560px; margin: 0 auto 30px !important; font-size: 18px; line-height: 1.7; color: var(--soft); }
  .pw-btn { display: inline-block; background: var(--navy); color: #fff; text-decoration: none; font-weight: 600; font-size: 17px; letter-spacing: .03em; padding: 16px 30px; border-radius: 4px; }
  .pw-btn:hover { background: #1f3a63; }
  .pw-sig { margin-top: 40px !important; font-size: 18px; line-height: 1.6; color: var(--soft); }
  .pw-sig em { font-family: 'Fontin', Georgia, serif; font-size: 21px; color: var(--navy); }

  .pw-contact { text-align: center; font-size: 15px; color: var(--light); padding: 34px 28px 44px; background: #fff; }
  .pw-contact a { color: var(--navy); }

  @media (max-width: 640px) {
    .pw-hero { padding: 60px 0 66px; }
    .pw-section { padding: 70px 0; }
    .pw-termin { padding: 22px 22px; display: block; }
  }
</style>

<style is:global>
  .sticky-cta { display: none !important; }
</style>
