const checkout = '#'; // ← ThriveCart-Checkout-URL hier eintragen

const kapitel = [
  { nr: 1,  color: '#2C4B7B', titel: 'Präsenz — Einander wirklich begegnen',       text: 'Stellt euch vor, ihr sitzt abends auf dem Sofa und schaut euch an — und etwas ist anders. Ihr seid wirklich da. Ihr entdeckt wieder etwas an eurem Partner, das ihr am Anfang so geliebt habt.' },
  { nr: 2,  color: '#3D7AAB', titel: 'Elternprägungen — Eure Muster verstehen',     text: 'Ihr werdet mitten im Streit plötzlich schmunzeln. Weil ihr erkennt: „Das ist ja gar nicht unser Streit. Das hat schon meine Mutter so gemacht." Eine ganz neue Freiheit liegt darunter.' },
  { nr: 3,  color: '#5AA0C4', titel: 'Gegenseitiges Coaching — Das Herzstück',      text: 'Statt zurückzuschießen, sagt ihr leise: „Schatz, coachst du mich?" Es fühlt sich an wie Ankommen. Wie endlich gesehen werden. Wie Zuhause.' },
  { nr: 4,  color: '#75BFDA', titel: 'Das innere Kind — Alte Wunden heilen',        text: 'Ein kleiner Junge, der nie genug war. Ein kleines Mädchen, das sich unsichtbar fühlte. Ihr begegnet diesen Teilen in euch — behutsam, gemeinsam. Und etwas Wunderbares geschieht.' },
  { nr: 5,  color: '#A9C4D8', titel: 'Eure Beziehungsbiografie',                    text: 'Ein langer Spaziergang durch eure gemeinsame Geschichte. Ihr erzählt euch Dinge, die ihr noch nie ausgesprochen habt. Am Ende spürt ihr: Da ist wieder etwas zwischen euch.' },
  { nr: 6,  color: '#E9B9C0', titel: 'Intensiv-Tage — Euer Trainingslager',         text: 'Ein Wochenende, das nur euch gehört. Am Sonntagabend fahrt ihr nach Hause mit einer Nähe, die ihr so seit Jahren nicht mehr erlebt habt.' },
  { nr: 7,  color: '#F7A9A8', titel: 'Gesundheit — Was euer Körper erzählt',        text: 'Ihr legt eure Krankengeschichte neben eure Lebensgeschichte. Plötzlich ergeben Dinge Sinn, die vorher nur „Pech" waren. Ein stilles, versöhnendes Kapitel.' },
  { nr: 8,  color: '#F89489', titel: 'Liebe & Sexualität — Einander wirklich berühren', text: 'Ihr sprecht über das, worüber die meisten Paare schweigen. Es ist verletzlich. Und genau deshalb so schön. Danach fühlt sich „Ich liebe dich" anders an. Voller. Wahrer.' },
  { nr: 9,  color: '#FA9D56', titel: 'Abschluss — Sich neu begegnen',               text: 'Ihr spielt ein Spiel, als hättet ihr euch gerade erst kennengelernt. Ihr lacht, ihr staunt, vielleicht weint ihr. Und ihr seht plötzlich wieder, wen ihr da eigentlich vor euch habt.' },
  { nr: 10, color: '#F5836A', bonus: true, titel: 'Bonus: Karma in der Beziehung',  text: 'Manche Themen tauchen immer wieder auf — über Jahre, manchmal über Generationen. In diesem Bonus-Kapitel schaut ihr auf die tieferen Schichten eurer Beziehung.' },
