/* Blauschleier von links, Orange-Lachs von rechts; Sonne (Mitte-rechts) bleibt frei, weiche Übergänge */
.hero-veil { position: absolute; inset: 0; background:
  linear-gradient(90deg, rgba(44,75,123,0.80) 0%, rgba(44,75,123,0.42) 24%, rgba(44,75,123,0) 47%),
  linear-gradient(270deg, rgba(250,157,86,0.62) 0%, rgba(250,157,86,0.24) 13%, rgba(250,157,86,0) 27%); }
.hero-inner { position: relative; z-index: 2; width: 100%; padding: clamp(72px,9vw,110px) 0; }
.hero-text { max-width: 620px; margin-top: -160px; }
.hero-eyebrow { font-family: var(--font-body); font-size: clamp(13px,1.2vw,15px); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.88); margin: 0 0 16px; }
.s-hero h1 { color: #fff; text-shadow: 0 2px 24px rgba(20,35,60,0.4); margin: 0 0 20px; font-size: clamp(30px, 3.9vw, 52px); line-height: 1.12; }
.s-hero h1 em { font-style: italic; color: var(--orange); font-size: clamp(42px, 5.6vw, 78px); white-space: nowrap; display: inline-block; }
.hero-sub .kursname { color: var(--orange); font-weight: 700; font-size: 1.12em; }
.hero-sub { font-size: clamp(19px,1.9vw,24px); color: rgba(255,255,255,0.90); margin: 0 0 14px; line-height: 1.5; }
.hero-with { font-size: 16px; color: rgba(255,255,255,0.80); margin: 0 0 44px; }
.btn-lg { font-size: 16px !important; padding: 18px 36px !important; }

/* ── shared ───────────────────────────────────────────────── */
