<script>
  // Sanftes Einblenden beim Scrollen — progressive enhancement: ohne JS oder mit
  // „Bewegung reduzieren" bleibt alles sofort sichtbar (Klassen werden erst hier gesetzt).
  const ziele = document.querySelectorAll(
    '.pain-list li, .woche-list li, .mit-card, .ablauf-text, .ablauf-img, ' +
    '.fuer-panel, .chance-box, .stimme-gross, .stimme, .schritt, .angebot-card, .faq-item, .galerie-grid img'
  );
  const reduziert = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduziert && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (eintraege) => {
        for (const e of eintraege) {
          if (e.isIntersecting) {
            e.target.classList.add('sichtbar');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );
    ziele.forEach((el) => {
      el.classList.add('reveal');
      io.observe(el);
    });
  }
</script>

<style>
/* ── MINIMAL-HEADER (kein Menü, kein Link raus) ──────────────── */
.header-minimal { background: var(--bg-white); padding: 18px 0; border-bottom: 1px solid rgba(184,149,107,0.18); }
