---
// Intensiv-Coaching-Woche Vogesen — Sales Page
// Zweiter Standort desselben Produkts wie intensiv-coaching-zypern.astro
// (gleicher Preis/Ablauf, andere Kulisse — Entscheidung Christian, 2026-08-25).
// Struktur von der Zypern-Seite übernommen; Video & Testimonials bewusst
// weggelassen, da für Vogesen noch keine vorhanden sind (nicht erfinden).
//
// ⚠️ PLATZHALTER — noch mit Annette/Herbert zu bestätigen:
//   - Preis (vorläufig identisch zu Zypern übernommen)
//   - Termine: September & Oktober 2026 in den Vogesen, keine festen Wochen.
//     Ab November läuft die Woche in Schopfheim weiter — auf dieser Seite nur
//     als Hinweis erwähnt (kein Umbau/keine zweite Seite, solange es für
//     Schopfheim noch kein eigenes Material gibt; Entscheidung Christian 2026-08-25)
//   - Genauer Ort/Adresse in den Vogesen (bewusst offen gehalten)
//   - Hero-/Ablauf-Fotos: bisher nur ein Foto vorhanden (Wiese/Gartentor) —
//     weitere Landschafts- und Hausfotos werden noch erwartet
// Siehe Projektdoku: Claude-Projekte/HSC-Vogesen-2026/01-Projektbeschreibung…
import FokusLayout from '../layouts/FokusLayout.astro';
import HeaderFokus from '../components/HeaderFokus.astro';
import FooterFokus from '../components/FooterFokus.astro';
import WaveDivider from '../components/WaveDivider.astro';
import TidalWave from '../components/TidalWave.astro';

const gespraech = 'https://orientierungsgespraech-himmelstoss.youcanbook.me';

// „Was passiert in dieser Woche" — identischer Prozess wie Zypern (Produktkern,
// nicht ortsgebunden). Farbleiter Blau → Lachs-Orange wie im Vorbild.
const woche = [
  { c: '#2C4B7B', t: 'Wir finden mit dir heraus, was deine wirkliche innere Vision ist — was du dir tief in deinem Inneren für dieses Leben vorgenommen hast.' },
  { c: '#5AA0C4', t: 'Wir lösen mit dir die festgefahrenen Muster und emotionalen Blockaden, die deiner Vision im Weg stehen. Dabei spielen meist Verletzungen aus der Kindheit oder Haltungen aus vorangehenden Leben eine Rolle.' },
  { c: '#E9B9C0', t: 'Am Ende der Woche wirst du nicht nur verstehen, was dich bisher zurückgehalten hat, sondern auch wissen, wie du es dauerhaft veränderst.' },
  { c: '#F89489', t: 'Du bekommst Werkzeuge für dein weiteres Leben. Diese Woche soll kein einmaliger „Schubser" sein, sondern eine nachhaltige Veränderung. Du gewinnst Klarheit, Leichtigkeit und neue Perspektiven.' },
  { c: '#FA9D56', t: 'Falls du in einer Beziehung bist: Du erkennst, warum ihr immer wieder in Konflikte geratet, wie du es lösen kannst — und wie ihr euch wirklich unterstützen könnt.' },
];

// „Was du aus dieser Woche mitnimmst"
const mitnehmen = [
  'Du verstehst, was dich bisher zurückgehalten hat, hast Blockaden gelöst und fühlst dich voller Energie.',
  'Du hast eine klare Richtung, weißt was du willst — und dadurch ein tiefes Gefühl von Sinnhaftigkeit.',
  'Veränderte Beziehungen — zu dir selbst, zu deinem Partner, zu deinem Umfeld. Du gehst mit neuer Offenheit und Tiefe auf deine Umgebung zu.',
  'Du erkennst deinen eigenen Wert und kannst dein Leben nach deinen Wünschen gestalten.',
  'Praktische Werkzeuge für deine Zukunft, um mit Herausforderungen umzugehen, ohne dich in alten Mustern zu verfangen.',
  'Falls du in einer Beziehung bist: Du weißt, wie ihr euch gegenseitig unterstützen könnt — statt euch unbewusst zu blockieren.',
];

// „Diese Woche ist für dich, wenn du …"
const fuerDich = [
  '<strong>tief sitzende Blockaden</strong> endlich lösen willst — statt nur oberflächliche Lösungen zu suchen.',
  'das Gefühl hast, dass <strong>„mehr"</strong> in dir steckt, du aber nicht weißt, wie du es freisetzen kannst.',
  'endlich den <strong>roten Faden</strong> hinter deinen Problemen erkennen willst — um frei zu sein.',
  'in einer Beziehung bist und eine <strong>tiefere, unterstützende Verbindung</strong> erleben möchtest.',
  'einfach <strong>dein Leben in die Hand nehmen</strong> möchtest.',
];

// Über Annette & Herbert — identisch zur Zypern-Seite (Fakten, nicht ortsgebunden)
const ueberPunkte = [
  '<strong>Annette:</strong> Ärztin seit 1997 — bis 2021 mit eigener Praxis für individuelle Gesundheitswege, international aufgesucht: von traumatisierten Menschen bis zu schulmedizinisch austherapierten Patienten. Dieses Wissen ist nicht weg, es steckt heute im Coaching.',
  '<strong>Herbert:</strong> Vom Waffengeschäft über die Kunsttherapie zum Waldorflehrer — heute Sucht-Experte, mit einem Ansatz, den er selbst entwickelt hat: nicht Verbote, sondern die Frage dahinter — <em>Was sucht ein Mensch hinter der Droge?</em> Über zwanzigtausend Menschen hat er so begleitet.',
  '<strong>Seit 1992 verheiratet, drei inzwischen erwachsene Kinder:</strong> Wir kennen die Herausforderungen von Beziehungen und Familie — und wie man gemeinsam wächst, statt sich zu verlieren.',
  '<strong>Anthroposophische Grundlage:</strong> Wir arbeiten mit den Lehren Rudolf Steiners und beziehen spirituelle Dimensionen mit ein — immer mit dem Blick darauf, wie das im konkreten Alltag wirksam wird.',
  '<strong>Seit 2021:</strong> Wir haben unser Leben komplett verändert und sind unserer Vision gefolgt — und begleiten dich dabei, deinen Weg zu finden.',
];
---

<FokusLayout
  title="Intensiv-Coaching-Woche Vogesen — Dein Weg zur tiefgehenden Transformation"
  description="Eine Woche in den Vogesen, tiefes Coaching mit Annette & Herbert Himmelstoß. Zweimal täglich individuelle Prozesse, Vollpension mitten im Grünen. Für dich allein oder als Paar."
  canonical="https://himmelstosscoaching.de/intensiv-coaching-vogesen"
>
  <HeaderFokus />

  <!-- 1 · HERO -->
  <!-- Bild als echter Parallax-Hintergrund (background-attachment: fixed auf Desktop) statt
       <img>, damit der Text beim Scrollen über das ruhende Bild läuft — auf Mobil (kein
       fixed-attachment-Support/UX) fällt es sauber auf normales Scrollen zurück. -->
  <!-- Bild rein dekorativ (CSS background) — der Ort wird im sichtbaren Text (Eyebrow,
       H1) bereits benannt, daher kein zusätzliches role="img"/aria-label nötig (würde
       Überschrift/Link für Screenreader sonst verschlucken). -->
  <section class="s-hero hero-fokus">
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <div class="hero-oben">
          <p class="hero-eyebrow">Retreat in den Vogesen · Frankreich</p>
          <h1>Intensiv-Coaching-Woche</h1>
        </div>
        <div class="hero-unten">
          <p class="hero-sub">Dein Weg zur <strong>tiefgehenden Transformation</strong> — allein oder als Paar.</p>
          <div class="hero-meta">
            <span>7 Tage · 6 Nächte</span>
            <span>Zweimal täglich Coaching</span>
            <span>Vollpension im Grünen</span>
          </div>
          <p class="hero-termin">September &amp; Oktober 2026 in den Vogesen · ab November in Schopfheim — Termin nach Absprache</p>
          <a href={gespraech} class="btn btn-primary btn-lg" target="_blank" rel="noopener">Kostenfrei Orientierungs-Gespräch buchen →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · PROBLEM -->
  <section class="s-problem">
    <div class="container narrow">
      <h2 class="center">Fühlst du dich festgefahren, ohne zu wissen, warum?</h2>
      <p class="lead center">Hast du das Gefühl, dein Leben könnte so viel mehr sein — aber irgendetwas hält dich zurück?</p>
      <ul class="pain-list">
        <li>Du spürst eine anhaltende Unzufriedenheit. Vielleicht bist du oft gestresst, fühlst dich müde oder perspektivlos. Du möchtest etwas verändern, doch egal was du versuchst — es klappt einfach nicht.</li>
        <li>Du fühlst dich innerlich blockiert — aber weißt nicht, woher es kommt. Und du spürst, dass es mehr geben muss.</li>
        <li>Du hast Wünsche und Träume, die du seit Jahren aufschiebst, weil immer etwas dazwischenkommt.</li>
        <li>Du funktionierst — aber das Leben fühlt sich an, als würde es an dir vorbeiziehen.</li>
        <li>Oder du hast sich wiederholende Konflikte in deiner Beziehung, die euch immer wieder in alte Muster zurückwerfen.</li>
      </ul>
      <p class="center problem-close"><em>Du versuchst, es mit Willenskraft zu lösen — aber es fühlt sich an, als ob du gegen eine unsichtbare Wand rennst.</em></p>
    </div>
    <WaveDivider fill="var(--bg-cream)" />
  </section>

  <!-- 3 · LÖSUNG / ES GIBT EINEN WEG -->
  <section class="s-weg">
    <div class="container narrow center">
      <p class="acc-eyebrow" style="justify-content:center">Es gibt einen Weg</p>
      <p class="lead">Wir sind wie gelenkt durch unbewusste Glaubenssätze, alte Verletzungen und emotionale Blockaden. Sie sorgen dafür, dass du im Kreis läufst, dich immer wieder in denselben Mustern verfängst — und dich fragst, warum du nicht weiterkommst.</p>
      <h2>Die Intensiv-Coaching-Woche</h2>
      <p>Eine Woche, die dein Leben nachhaltig, tiefgehend und effektiv verändern kann — egal ob du allein oder ihr als Paar kommt. Fernab vom Alltag, mitten in der Ruhe der Vogesen.</p>
      <a href={gespraech} class="btn btn-primary" target="_blank" rel="noopener">Jetzt Orientierungs-Gespräch buchen →</a>
    </div>
    <WaveDivider fill="var(--bg-white)" />
  </section>

  <!-- 4 · WAS PASSIERT IN DIESER WOCHE -->
  <section class="s-passiert">
    <div class="container narrow">
      <h2 class="center">Was passiert in dieser Woche?</h2>
      <ul class="check-list woche-list">
        {woche.map((w) => <li style={`--wc: ${w.c}`}>{w.t}</li>)}
      </ul>
    </div>
    <WaveDivider fill="var(--bg-cream)" />
  </section>

  <!-- 5 · WAS DU MITNIMMST -->
  <section class="s-mitnehmen">
    <div class="container">
      <h2 class="center">Was du aus dieser Woche mitnimmst</h2>
      <div class="mit-grid">
        {mitnehmen.map((m) => (
          <div class="mit-card"><p>{m}</p></div>
        ))}
      </div>
    </div>
    <WaveDivider fill="var(--bg-white)" />
  </section>

  <!-- 6 · DU STEHST IM MITTELPUNKT / ABLAUF -->
  <section class="s-ablauf">
    <div class="container ablauf-grid">
      <div class="ablauf-text">
        <p class="acc-eyebrow">Du stehst im Mittelpunkt</p>
        <h2>Wir sind die ganze Woche für dich da</h2>
        <p>Zweimal täglich begleiten wir dich mit individuellen Coaching-Prozessen, um dein mitgebrachtes Thema zu lösen und nachhaltige Veränderungen zu ermöglichen.</p>
        <p>Dazwischen hast du genügend Raum, um das Erlebte nachklingen zu lassen, es zu verankern und die Ruhe und Natur der Vogesen zu genießen: ein Spaziergang durch Wald und Wiesen, Stille in den Bergen.</p>
      </div>
      <div class="ablauf-img ablauf-img--haus">
        <img src="/img/vogesen/garten-wiese.jpg" alt="Wiese und Garten des Hauses in den Vogesen, umgeben von Bäumen" loading="lazy" />
      </div>
    </div>

    <div class="container ablauf-grid reverse">
      <div class="ablauf-text ablauf-text--platzhalter">
        <h3>Unterkunft &amp; Verpflegung</h3>
        <p>Du genießt während deines Aufenthalts eine liebevolle Rundum-Versorgung mit Vollpension. Herbert ist ein ausgezeichneter Koch — wir besprechen gerne vorab deine Essenswünsche, Unverträglichkeiten oder besonderen Vorlieben mit dir.</p>
        <!-- Platzhalter: konkrete Angaben zu Zimmer/Ausstattung folgen, sobald weitere Fotos & Details vorliegen -->
        <p class="hinweis-platzhalter">Weitere Eindrücke von Haus und Umgebung folgen in Kürze.</p>
      </div>
    </div>
    <WaveDivider fill="var(--bg-cream)" />
  </section>

  <!-- 7 · FÜR WEN / CHANCE -->
  <section class="s-fuer">
    <div class="container narrow">
      <h2 class="center">Diese Woche ist für dich,<br>wenn du …</h2>
      <div class="fuer-panel">
        <ul class="fuer-list">
          {fuerDich.map((f) => <li set:html={f} />)}
        </ul>
      </div>
      <div class="chance-box">
        <p>Das ist deine Chance, dein Leben wirklich zu verändern.</p>
        <ul>
          <li>Kein weiteres Jahr, in dem du dich mit denselben Problemen herumschlägst.</li>
          <li>Kein weiteres Warten, bis sich „irgendwas von selbst ändert".</li>
          <li>Keine weiteren Versuche, „es allein zu schaffen" — während du dich weiterhin festgefahren fühlst.</li>
        </ul>
      </div>
    </div>
    <TidalWave />
  </section>

  <!-- 8 · HAUPTANGEBOT / CTA -->
  <section class="s-angebot" id="angebot">
    <div class="container narrow center">
      <p class="eyebrow-light">Dein Platz</p>
      <h2 class="angebot-hl">Diese Woche ist ein Schlüssel zur echten Veränderung</h2>
      <p class="angebot-intro">Wenn du spürst, dass jetzt die richtige Zeit ist, dann laden wir dich herzlich ein, mit uns diese Woche zu erleben.</p>

      <div class="angebot-card">
        <dl class="angebot-facts">
          <div><dt>Ort</dt><dd>Unser Haus in den Vogesen, Frankreich</dd></div>
          <div><dt>Termin</dt><dd>September &amp; Oktober 2026 in den Vogesen, ab November in Schopfheim — wir finden gemeinsam deine Woche</dd></div>
          <div><dt>Dauer</dt><dd>7 Tage · 6 Nächte</dd></div>
          <div><dt>Inklusive</dt><dd>Tägliche intensive Sitzungen, Vollpension, eine entspannte und unterstützende Umgebung</dd></div>
          <div><dt>Invest</dt><dd><strong>einzeln 4.200 €</strong> · als Paar 5.700 €</dd></div>
        </dl>
        <p class="angebot-aufgabe">Deine einzige Aufgabe: ankommen, loslassen und bereit sein für echte Veränderung. Wir sind für dich da.</p>
        <a href={gespraech} class="btn btn-primary btn-lg" target="_blank" rel="noopener">Termin für ein Gespräch aussuchen →</a>
        <p class="angebot-note">kostenfrei &amp; unverbindlich</p>
      </div>
    </div>
  </section>

  <!-- 9 · ÜBER ANNETTE & HERBERT -->
  <section class="s-ueber">
    <div class="container ueber-grid">
      <div class="ueber-img">
        <img src="/img/annette-herbert-about.jpg" alt="Annette und Herbert Himmelstoß" loading="lazy" />
      </div>
      <div class="ueber-text">
        <p class="acc-eyebrow">Wer wir sind</p>
        <h2>Wir sind Annette &amp; Herbert Himmelstoß</h2>
        <p>Wir sind nicht nur deine Begleiter — wir leben, was wir mit dir teilen. Gemeinsam sind wir durch die Höhen und Tiefen des Lebens gegangen und haben dabei gelernt, Krisen als Wachstumschancen zu sehen.</p>
        <ul class="ueber-list">
          {ueberPunkte.map((u) => <li set:html={u} />)}
        </ul>
      </div>
    </div>
    <WaveDivider fill="var(--bg-cream)" />
  </section>

  <!-- 10 · FRAGEN / ABSCHLUSS-CTA -->
  <section class="s-final final-fokus">
    <div class="container narrow center">
      <h2 class="final-hl">Hast du noch Fragen?</h2>
      <p class="final-text">Wir nehmen uns sehr gerne Zeit für dich.</p>
      <a href={gespraech} class="btn btn-primary btn-lg" target="_blank" rel="noopener">Orientierungs-Gespräch buchen →</a>
      <p class="final-meta">kostenfrei &amp; unverbindlich</p>
    </div>
  </section>

  <!-- 11 · ERSTER EINDRUCK (Platzhalter-Galerie — nur 1 Foto vorhanden) -->
  <section class="s-galerie">
    <TidalWave top flip fadeTo="var(--bg-cream)" opacity={1} />
    <div class="container">
      <h2 class="center">Ein erster Eindruck aus den Vogesen</h2>
      <p class="center galerie-hinweis">Weitere Bilder vom Haus und der Umgebung folgen in Kürze.</p>
      <div class="galerie-grid galerie-grid--einzeln">
        <img src="/img/vogesen/garten-wiese.jpg" alt="Wiese mit altem Holztor und Blick auf ein Haus, umgeben von Bäumen — Vogesen, Frankreich" loading="lazy" />
      </div>
    </div>
  </section>

  <FooterFokus />
</FokusLayout>

<style>
/* ── HERO ─────────────────────────────────────────────────── */
.s-hero {
  position: relative; min-height: clamp(560px, 76vh, 820px); display: flex; align-items: stretch; overflow: hidden; padding: 0;
  background-image: url('/img/vogesen/garten-wiese.jpg');
  background-size: cover;
  background-position: center 40%;
  /* Echtes Parallax: das Bild "steht" im Viewport fest, die Section (und damit der Text)
     scrollt darüber hinweg. Auf Touch-Geräten kein verlässlicher Support + oft ruckelig
     → dort per Media Query zurück auf normales Scrollen (siehe unten). */
  background-attachment: fixed;
}
/* Deutlich kräftigerer, gleichmäßiger Dunkel-Schleier (Grundproblem vorher: helle
   Wiesen-/Himmelpartien im Foto machten weißen Text stellenweise unlesbar). Radialer
   Kern zusätzlich dunkler genau dort, wo der Text liegt — unabhängig davon, was im
   Bild darunter gerade hell oder dunkel ist. Leichte Blau-Tönung an den Rändern hält
   die Markenfarbe präsent, ohne die Lesbarkeit zu kosten. */
.hero-veil { position: absolute; inset: 0; background:
  radial-gradient(ellipse 70% 65% at 50% 52%, rgba(10,20,16,0.62) 0%, rgba(10,20,16,0.40) 55%, rgba(10,20,16,0.22) 100%),
  linear-gradient(180deg, rgba(8,16,13,0.30) 0%, rgba(8,16,13,0.12) 30%, rgba(8,16,13,0.20) 65%, rgba(8,16,13,0.55) 100%),
  linear-gradient(90deg, rgba(20,45,60,0.22) 0%, rgba(20,45,60,0) 40%); }
.hero-inner { position: relative; z-index: 2; width: 100%; padding: clamp(56px,7vw,84px) 0 clamp(28px,3.5vw,48px); display: flex; }
.hero-text { max-width: 980px; margin: 0 auto; text-align: center; flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 40px; animation: hero-rise 1.1s var(--ease) both; }
@keyframes hero-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
/* Feine Trennlinie unter der Vorzeile — kleiner, edler Akzent statt reiner Textmasse. */
.hero-eyebrow { position: relative; font-family: var(--font-body); font-size: clamp(15px,1.5vw,19px); font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: #fff; margin: 0 0 22px; text-shadow: 0 1px 10px rgba(0,0,0,0.55); }
.hero-eyebrow::after { content: ''; position: absolute; left: 50%; bottom: -12px; transform: translateX(-50%); width: 56px; height: 1px; background: rgba(255,255,255,0.55); }
.s-hero h1 { color: #fff; text-shadow: 0 2px 16px rgba(0,0,0,0.55), 0 6px 40px rgba(0,0,0,0.35); margin: 0 0 22px; }
.hero-sub { font-size: clamp(21px,2.2vw,27px); color: #fff; margin: 0 0 14px; line-height: 1.5; text-shadow: 0 2px 14px rgba(0,0,0,0.55); }
.hero-sub strong { color: #FFD800; font-weight: 700; }
.hero-meta { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 20px; margin: 0 0 10px; font-size: 18px; color: #fff; font-weight: 700; text-shadow: 0 1px 10px rgba(0,0,0,0.55); }
.hero-meta span + span::before { content: '·'; margin-right: 8px; }
.hero-termin { margin: 0 0 26px; font-size: 15px; font-weight: 600; color: #fff; text-shadow: 0 1px 10px rgba(0,0,0,0.55); }
.hero-text .btn-lg { font-size: 15px !important; padding: 13px 28px !important; }
@media (hover: none), (max-width: 860px) {
  /* iOS/Touch: background-attachment:fixed ist unzuverlässig/laggy → normales Scrollen */
  .s-hero { background-attachment: scroll; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-text { animation: none; }
}

/* ── PROBLEM ──────────────────────────────────────────────── */
.s-problem { background: var(--bg-white); }
.s-problem h2 { margin-bottom: 18px; }
.lead { font-family: var(--font-display); font-style: italic; font-size: clamp(19px,1.8vw,24px); line-height: 1.5; color: var(--blue-deep); }
.pain-list { list-style: none; padding: 0; margin: 36px 0; display: flex; flex-direction: column; gap: 12px; }
.pain-list li { padding: 26px 20px 16px 52px; background: var(--bg-cream); border-radius: 8px; position: relative; overflow: hidden; font-size: 16px; color: var(--ink-soft); line-height: 1.6; }
.pain-list li::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px; background: var(--sun-strip); background-size: 200% 100%; animation: sun-shimmer 14s ease-in-out infinite; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
.pain-list li::after { content: '›'; position: absolute; left: 20px; top: 24px; color: var(--orange); font-size: 22px; font-weight: 700; line-height: 1; }
.problem-close { font-family: var(--font-display); font-style: italic; font-size: clamp(18px,1.7vw,22px); color: var(--blue-deep); margin-top: 8px; }

/* ── ES GIBT EINEN WEG ────────────────────────────────────── */
.s-weg { background: var(--bg-cream); }
.s-weg .acc-eyebrow { margin-bottom: 50px; }
.s-weg h2 { margin: 64px 0 12px; }
.s-weg > .container > a.btn { margin-top: 32px; }
.acc-eyebrow { font-size: var(--eyebrow-size); }

/* ── CHECK-LIST (Was passiert) ────────────────────────────── */
.check-list { list-style: none; padding: 0; margin: 36px 0; display: flex; flex-direction: column; gap: 14px; }
.check-list li { padding: 4px 0 4px 40px; position: relative; font-size: 17px; color: var(--ink-soft); line-height: 1.6; }
.check-list li::before { content: '✓'; position: absolute; left: 0; top: 3px; color: var(--orange); font-weight: 700; font-size: 20px; }
.woche-list { gap: 12px; }
.woche-list li { padding: 20px 24px 20px 56px; background: color-mix(in srgb, var(--wc) 12%, var(--bg-white)); border-top: 4px solid var(--wc); border-radius: var(--radius-card); color: var(--ink); }
.woche-list li::before { content: '✓'; left: 22px; top: 21px; color: var(--wc); }
.s-passiert { background: var(--bg-white); padding-top: clamp(64px,12vw,128px); }

/* ── WAS DU MITNIMMST ─────────────────────────────────────── */
.s-mitnehmen { background: var(--bg-cream); }
.s-mitnehmen h2 { margin-bottom: clamp(36px,5vw,52px); }
.mit-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
