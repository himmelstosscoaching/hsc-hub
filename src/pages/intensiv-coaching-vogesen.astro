/* ── RESPONSIVE ───────────────────────────────────────────── */
@media (max-width: 860px) {
  .s-hero      { min-height: 580px; align-items: flex-end; background-position: center 20%; }
  .hero-inner  { padding-bottom: 52px; }
  .hero-text   { max-width: 100%; gap: 22px; }
  /* Handy: Der Text füllt fast die ganze Höhe. Deshalb bleibt oben nur ein schmaler
     Bildstreifen stehen, danach läuft es zügig ins einfarbige Marken-Blau — sonst
     stünde die Überschrift wieder mitten in den hellen Wolken.
     Bewusst in PIXELN statt Prozent: der Hero wird hier durch die Textlänge ~790px
     hoch, bei Prozentwerten rutschte der einfarbige Bereich unter die Überschrift
     (gemessen: H1 sitzt bei 129–230px ab Hero-Oberkante). */
  /* Handy: gleiche Idee, nur zuegiger — der Text faengt hier schon bei ~130px an,
     also muss die helle Flaeche frueher da sein. Bewusst in PIXELN, weil der Hero
     durch die Textlaenge ~790px hoch wird und Prozentwerte dann danebenliegen. */
  .hero-veil   { background:
    linear-gradient(180deg,
      rgba(255,248,236,0)     30px,
      rgba(255,247,234,0.34) 130px,
      rgba(255,246,232,0.46) 240px,
      rgba(255,246,232,0.42) 420px,
      rgba(255,245,230,0.20) 100%),
    radial-gradient(ellipse 78% 34% at 0% 8%,   rgba(39,131,172,0.62) 0%, rgba(39,131,172,0) 76%),
    radial-gradient(ellipse 78% 34% at 100% 8%, rgba(250,157,86,0.56) 0%, rgba(248,148,137,0.20) 44%, rgba(250,157,86,0) 76%); }
  /* Die Weichzeichnung muss am Handy fast die ganze Breite fassen — die Schrift laeuft
     hier von Rand zu Rand, nicht in einer schmalen Saeule wie am Bildschirm. */
  .hero-veil::after {
    mask-image: radial-gradient(ellipse 94% 60% at 50% 54%,
      rgba(0,0,0,1) 0%, rgba(0,0,0,0.95) 52%, rgba(0,0,0,0.55) 80%, rgba(0,0,0,0) 100%);
    -webkit-mask-image: radial-gradient(ellipse 94% 60% at 50% 54%,
      rgba(0,0,0,1) 0%, rgba(0,0,0,0.95) 52%, rgba(0,0,0,0.55) 80%, rgba(0,0,0,0) 100%); }

  /* Haengende Trennpunkte vermeiden: am Handy brechen die Zeilen ohnehin um, also
