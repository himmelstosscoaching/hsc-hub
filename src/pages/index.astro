---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHub from '../components/HeroHub.astro';
import AboutPair from '../components/AboutPair.astro';
import SelfCheck from '../components/SelfCheck.astro';
import OfferCard from '../components/OfferCard.astro';
import Testimonial from '../components/Testimonial.astro';
import FAQItem from '../components/FAQItem.astro';
import Footer from '../components/Footer.astro';
import { f1, f2, f3, kongress, event2026 } from '../data/offers';

const faqs = [
  {
    q: 'Mein Partner macht da nicht mit. Bringt mir das trotzdem was?',
    a: 'Ja. Unsere Erfahrung: Wenn einer beginnt, ändert sich die Dynamik — und meistens wird der andere neugierig. Bei „Schatz, coachst du mich?" gibt es ein eigenes Kapitel zu genau dieser Situation.',
  },
  {
    q: 'Ist das Coaching oder Therapie?',
    a: 'Coaching. Wir arbeiten nicht mit Diagnosen oder Symptomen, sondern mit Mustern, Prägungen und konkreten Übungen für den Alltag. Bei akuten Krisen mit Gewalt oder Sucht empfehlen wir professionelle therapeutische Hilfe.',
  },
  {
    q: 'Wie viel Zeit muss ich investieren?',
    a: 'Bei den Online-Kursen rechnen wir mit etwa zwei Wochen pro Kapitel. Die zentralen Übungen dauern 15 bis 30 Minuten. Coaching-Termine sind in der Regel 60 bis 90 Minuten.',
  },
  {
    q: 'Was kostet ein Kennenlerngespräch?',
    a: 'Nichts. Ein erstes Gespräch ist kostenfrei — wir klären gemeinsam, ob und wie wir zusammen arbeiten.',
  },
  {
    q: 'Bekomme ich mein Geld zurück, wenn der Kurs nicht passt?',
    a: 'Bei unseren Online-Kursen gilt eine 14-tägige Rückgabegarantie. Bei Retreats und Coachings gelten individuelle Bedingungen, die wir vor der Buchung klar mit dir besprechen.',
  },
  {
    q: 'Wie funktioniert ein Retreat in Zypern?',
    a: 'Eine Woche an einem privaten Standort am Meer. Tägliche Sessions mit uns, viel Zeit für euch, Strand und Stille. Die Anreise organisierst du selbst, alles vor Ort ist vorbereitet.',
  },
];

const testimonials = [
  {
    quote: 'Wir leben heute ehrlicher, wahrhaftiger, näher zueinander. Das was wir bei euch gelernt haben, wenden wir täglich an.',
    author: 'Heike & Frank',
    note: 'Schatz, coachst du mich? · Beta-Gruppe',
  },
  {
    quote: 'Ich habe Dinge an meiner Frau wiederentdeckt, die ich seit Jahren nicht mehr wahrgenommen hatte. Es ist wie ein zweites Verlieben.',
    author: 'Armin',
    note: 'Schatz, coachst du mich? · Paargruppe',
  },
  {
    quote: 'Ich habe nie gelernt, wie man mit Themen umgehen kann. Hier habe ich es zum ersten Mal verstanden — und es funktioniert.',
    author: 'Frank',
    note: 'Schatz, coachst du mich?',
  },
  {
    quote: 'Was für ein großartiges Paar, Annette und Herbert. Ihre Sicht öffnet Räume, von denen ich vorher nicht wusste, dass es sie gibt.',
    author: 'Maren & Markus Strüfing',
    note: 'Paar-Coaching',
  },
  {
    quote: 'Ich habe gelernt, dass ich einen eigenen Raum habe. Ich fühle mich wieder sicher in Gesprächen.',
    author: 'Julia Brune',
    note: '1:1 Life-Coaching',
  },
];
---

<BaseLayout
  title="Himmelsstoß Coaching · Annette & Herbert"
  description="Online-Kurse, Retreats und persönliche Begleitung für Paare und Menschen, die mehr Tiefe und Klarheit suchen."
>
  <!-- A — HERO -->
  <HeroHub />

  <!-- B — MANIFEST (Editorial — Cream, Akzent-Linie) -->
  <section class="manifest">
    <div class="narrow">
      <span class="acc-eyebrow center-eb">Worum es uns geht</span>
      <h2 class="manifest-headline">Das Lebendige ins Leben bekommen — jeder von seinem Start.</h2>
      <p class="manifest-body">
        Das Leben passiert nicht im Außen. Es wird gelesen — in dir, in deiner Partnerschaft,
        in deinen Reaktionen. Wir sind über 30 Jahre verheiratet, haben zwei Schlaganfälle erlebt,
        sind vier Monate durch Südafrika gereist — und immer wieder festgestellt:
        das Lebendige ist eine Entscheidung. Wir zeigen dir, wie du sie triffst.
      </p>
    </div>
  </section>

  <!-- C — ÜBER A&H -->
  <AboutPair />

  <!-- D — SELBSTCHECK -->
  <SelfCheck />

  <!-- E — TRUST-BRIDGE + BUCH -->
  <section class="trust-bridge">
    <div class="container">
      <div class="book-row">
        <div class="book-cover">
          <!-- IMAGE-SLOT: Buchcover „Mit keinem nicht einer glücklichen Beziehung" -->
          <div class="img-slot">
            <strong>Bild-Slot</strong>
            Buchcover<br>
            „Mit keinem nicht einer<br>
            glücklichen Beziehung"<br><br>
            Hochformat 2:3<br>
            (Cover-Scan oder Mockup)
          </div>
        </div>
        <div class="book-text">
          <span class="acc-eyebrow">Unser Buch</span>
          <h2>Mit keinem nicht einer glücklichen Beziehung</h2>
          <p>
            Unsere Sicht auf Partnerschaft, Krise und das, was beide tragen kann.
            Erschienen 2023. Verfügbar im Handel und bei Amazon.
          </p>
          <a
            href="https://www.amazon.de/keinem-nicht-einer-gl%C3%BCcklichen-Beziehung/dp/3911174004/"
            target="_blank"
            rel="noopener"
            class="link-arrow"
          >Bei Amazon ansehen <span>→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- F — ANGEBOTE (3 Bündel — Wechsel Weiß/Cream) -->
  <section id="angebote" class="offers offers-intro">
    <div class="container">
      <div class="section-intro">
        <span class="acc-eyebrow center-eb">Unsere Angebote</span>
        <h2>Eine Tür — viele Räume.</h2>
        <p>Drei Wege, wie du mit uns arbeiten kannst — vom Selbstlernkurs bis zum Retreat am Meer.</p>
      </div>
    </div>
  </section>

  <!-- F1 — Selbst-Lernen (Weiß) -->
  <section id="cluster-f1" class="cluster cluster-light">
    <div class="container">
      <div class="cluster-head">
        <h3>Selbst-Lernen</h3>
        <p>Online-Kurse, die du jederzeit starten kannst.</p>
      </div>
      <div class="offer-grid">
        {f1.map((o) => <OfferCard offer={o} />)}
      </div>
    </div>
  </section>

  <!-- F2 — Begleitung (Cream) -->
  <section id="cluster-f2" class="cluster cluster-cream">
    <div class="container">
      <div class="cluster-head">
        <h3>Begleitung</h3>
        <p>Persönliche Räume — 1:1 oder in kleiner Gruppe.</p>
      </div>
      <div class="offer-grid">
        {f2.map((o) => <OfferCard offer={o} />)}
      </div>
    </div>
  </section>

  <!-- F3 — Vor Ort (Weiß) -->
  <section id="cluster-f3" class="cluster cluster-light">
    <div class="container">
      <div class="cluster-head">
        <h3>Vor Ort</h3>
        <p>Zeit für euch — an einem besonderen Ort, mit anderen Menschen.</p>
      </div>
      <div class="offer-grid">
        {f3.map((o) => <OfferCard offer={o} />)}
      </div>
    </div>
  </section>

  <!-- G — COMMUNITY EVENT (Editorial-Highlight, kein Vollflächen-Verlauf) -->
  <section class="event-highlight">
    <div class="container">
      <div class="event-inner">
        <div class="event-text">
          <span class="acc-eyebrow">{event2026.eyebrow}</span>
          <h2>{event2026.headline}</h2>
          <p class="event-promise">{event2026.promise}</p>
          <ul class="event-bullets">
            {event2026.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <a href={event2026.ctaUrl} target="_blank" rel="noopener" class="btn-event">
            {event2026.ctaText} <span>→</span>
          </a>
          <p class="event-note">{event2026.note}</p>
        </div>
        <div class="event-image">
          <!-- IMAGE-SLOT: Stimmungsfoto Burg/Schloss/Hotel in Natur, Abendstimmung -->
          <div class="img-slot">
            <strong>Bild-Slot</strong>
            Stimmungsfoto Event-Ort<br>
            (Burg/Schloss/Hotel in Natur)<br>
            Querformat 4:3 · ~1200×900
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- H — ONLINE-KONGRESS (kompakter Banner, kein Vollflächen-Verlauf) -->
  <section class="kongress">
    <div class="container">
      <div class="kongress-banner">
        <div class="kongress-text">
          <span class="acc-eyebrow">{kongress.eyebrow}</span>
          <h2>{kongress.headline}</h2>
          <p>{kongress.promise}</p>
        </div>
        <a href={kongress.ctaUrl} target="_blank" rel="noopener" class="btn-kongress">
          {kongress.ctaText} <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- I — TESTIMONIALS -->
  <section class="testimonials">
    <div class="container">
      <div class="section-intro">
        <span class="acc-eyebrow center-eb">Stimmen</span>
        <h2>Wer mit uns gearbeitet hat</h2>
      </div>
      <div class="testi-grid">
        {testimonials.map((t) => <Testimonial quote={t.quote} author={t.author} note={t.note} />)}
      </div>
    </div>
  </section>

  <!-- J — FAQ -->
  <section class="faq">
    <div class="narrow">
      <div class="section-intro">
        <span class="acc-eyebrow center-eb">Häufige Fragen</span>
        <h2>Bevor du klickst — die wichtigsten Antworten</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => <FAQItem question={f.q} answer={f.a} />)}
      </div>
    </div>
  </section>

  <!-- K — FINAL CTA (Tiefblau, ruhig — wie ein Buchcover) -->
  <section class="final-cta">
    <div class="container">
      <div class="final-inner">
        <span class="acc-eyebrow">Nächster Schritt</span>
        <h2>Bereit für ein Gespräch?</h2>
        <p>
          Ein kostenfreies Kennenlerngespräch ist der einfachste Einstieg.
          Wir hören dir zu, du fühlst, ob wir passen.
        </p>
        <a
          href="https://outlook.office365.com/owa/calendar/HimmelstoCoaching1@himmelstosscoaching.de/bookings/"
          target="_blank"
          rel="noopener"
          class="btn-final"
        >
          Kennenlerngespräch buchen <span>→</span>
        </a>

        <div class="newsletter">
          <h3>Sonntagsgespräch</h3>
          <p>Jeden Sonntag ein Brief von uns. Gedanken, Impulse, Geschichten. Kein Spam.</p>
          <form class="newsletter-form" action="#" method="post" onsubmit="event.preventDefault(); alert('Quentn-Endpunkt einsetzen');">
            <input type="email" name="email" placeholder="Deine E-Mail-Adresse" required />
            <button type="submit">Anmelden</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* ──────────────────────────────────────────────────
     Globale Editorial-Helfer
     ────────────────────────────────────────────────── */

  /* Akzent-Eyebrow — feine Linie + Text */
  :global(.acc-eyebrow) {
    font-family: 'League Spartan', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--orange);
    display: inline-block;
    position: relative;
    padding-left: 36px;
    margin-bottom: 18px;
  }
  :global(.acc-eyebrow::before) {
    content: "";
    position: absolute;
    left: 0; top: 50%;
    width: 24px; height: 1px;
    background: var(--orange);
  }
  :global(.acc-eyebrow.center-eb) {
    padding-left: 0;
    padding-bottom: 14px;
  }
  :global(.acc-eyebrow.center-eb::before) {
    left: 50%;
    top: auto;
    bottom: 0;
    transform: translateX(-50%);
    width: 32px;
  }

  /* ──────────────────────────────────────────────────
     B — Manifest
     ────────────────────────────────────────────────── */
  .manifest {
    background: var(--cream);
    padding: 130px 0;
    text-align: center;
  }
  .manifest .narrow { max-width: 780px; }
  .manifest-headline {
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.25;
    color: var(--blue-deep);
    margin-bottom: 32px;
    letter-spacing: -0.01em;
  }
  .manifest-body {
    font-family: 'Fontin', serif;
    font-style: italic;
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.65;
    color: var(--text-soft);
    max-width: 680px;
    margin: 0 auto;
  }

  /* ──────────────────────────────────────────────────
     E — Trust-Bridge mit Buch
     ────────────────────────────────────────────────── */
  .trust-bridge {
    background: #fff;
    padding: 100px 0;
  }
  .book-row {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 60px;
    align-items: center;
    max-width: 900px;
    margin: 0 auto;
  }
  .book-cover .img-slot {
    aspect-ratio: 2 / 3;
    min-height: 0;
    border: 1px dashed rgba(232, 138, 104, 0.5);
    background: linear-gradient(135deg, #f5ebe0 0%, #e8d9c4 100%);
  }
  .book-text h2 {
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.25;
    color: var(--blue-deep);
    margin-bottom: 16px;
  }
  .book-text p {
    font-size: 17px;
    color: var(--text-soft);
    line-height: 1.65;
    margin-bottom: 18px;
  }
  .link-arrow {
    font-family: 'League Spartan', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue-deep);
    border-bottom: 1.5px solid var(--blue-deep);
    padding-bottom: 4px;
    text-decoration: none;
    transition: all .25s;
  }
  .link-arrow span { transition: transform .25s; display: inline-block; margin-left: 4px; }
  .link-arrow:hover { color: var(--orange); border-color: var(--orange); text-decoration: none; }
  .link-arrow:hover span { transform: translateX(4px); }
  @media (max-width: 768px) {
    .book-row { grid-template-columns: 1fr; gap: 36px; }
    .book-cover { max-width: 220px; }
  }

  /* ──────────────────────────────────────────────────
     F — Angebote
     ────────────────────────────────────────────────── */
  .offers-intro {
    background: #fff;
    padding: 110px 0 50px;
  }
  .offers-intro .section-intro { margin-bottom: 0; }
  .offers-intro h2 {
    font-size: clamp(32px, 4vw, 48px);
    color: var(--blue-deep);
  }

  .cluster {
    padding: 70px 0 90px;
  }
  .cluster-light { background: #fff; }
  .cluster-cream { background: var(--cream); }

  .cluster-head {
    max-width: 720px;
    margin: 0 auto 50px;
    text-align: center;
  }
  .cluster-head h3 {
    font-size: clamp(28px, 3vw, 38px);
    color: var(--blue-deep);
    margin-bottom: 10px;
    font-weight: 700;
  }
  .cluster-head p {
    font-family: 'Fontin', serif;
    font-style: italic;
    color: var(--text-soft);
    font-size: 18px;
  }
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  /* ──────────────────────────────────────────────────
     G — Event Highlight (Editorial, Cream)
     ────────────────────────────────────────────────── */
  .event-highlight {
    background: var(--cream);
    padding: 120px 0;
    position: relative;
  }
  .event-highlight::before {
    content: "";
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 3px;
    background: var(--orange);
  }
  .event-inner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 70px;
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
  }
  .event-inner h2 {
    font-size: clamp(28px, 3.5vw, 42px);
    color: var(--blue-deep);
    margin-bottom: 20px;
    line-height: 1.2;
  }
  .event-promise {
    font-family: 'Fontin', serif;
    font-style: italic;
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-soft);
    margin-bottom: 24px;
  }
  .event-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
  }
  .event-bullets li {
    padding-left: 20px;
    position: relative;
    margin-bottom: 10px;
    color: var(--text);
    font-size: 16px;
  }
  .event-bullets li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--orange);
  }
  .btn-event {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 32px;
    background: var(--blue-deep);
    color: #fff !important;
    font-family: 'League Spartan', sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 50px;
    text-decoration: none;
    transition: all .3s;
  }
  .btn-event:hover { background: #1e3556; text-decoration: none; transform: translateY(-1px); }
  .btn-event span { transition: transform .25s; }
  .btn-event:hover span { transform: translateX(4px); }
  .event-note { font-size: 13px; color: var(--text-light); margin-top: 14px; font-style: italic; }
  .event-image .img-slot { min-height: 320px; aspect-ratio: 4 / 3; }
  @media (max-width: 768px) { .event-inner { grid-template-columns: 1fr; gap: 40px; } }

  /* ──────────────────────────────────────────────────
     H — Kongress (kompakter Banner)
     ────────────────────────────────────────────────── */
  .kongress {
    background: #fff;
    padding: 70px 0;
  }
  .kongress-banner {
    background: var(--cream);
    border-left: 3px solid var(--orange);
    padding: 44px 50px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    max-width: 1000px;
    margin: 0 auto;
    border-radius: 0 4px 4px 0;
  }
  .kongress-banner h2 {
    font-size: clamp(22px, 2.4vw, 28px);
    color: var(--blue-deep);
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .kongress-banner p {
    margin: 0;
    color: var(--text-soft);
    font-size: 16px;
  }
  .kongress-text { flex: 1; }
  .btn-kongress {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 26px;
    background: transparent;
    color: var(--blue-deep) !important;
    border: 1.5px solid var(--blue-deep);
    font-family: 'League Spartan', sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 50px;
    text-decoration: none;
    transition: all .3s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .btn-kongress:hover { background: var(--blue-deep); color: #fff !important; text-decoration: none; }
  .btn-kongress span { transition: transform .25s; }
  .btn-kongress:hover span { transform: translateX(4px); }
  @media (max-width: 720px) {
    .kongress-banner { flex-direction: column; align-items: flex-start; padding: 32px 28px; }
  }

  /* ──────────────────────────────────────────────────
     I — Testimonials
     ────────────────────────────────────────────────── */
  .testimonials {
    background: var(--cream);
    padding: 110px 0;
  }
  .testimonials h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    color: var(--blue-deep);
  }
  .testi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  /* ──────────────────────────────────────────────────
     J — FAQ
     ────────────────────────────────────────────────── */
  .faq {
    background: #fff;
    padding: 110px 0;
  }
  .faq h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    color: var(--blue-deep);
  }

  /* ──────────────────────────────────────────────────
     K — Final CTA (Tiefblau, ruhig)
     ────────────────────────────────────────────────── */
  .final-cta {
    background: var(--blue-deep);
    padding: 130px 0;
    color: #fff;
  }
  .final-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .final-cta .acc-eyebrow {
    color: var(--rose);
    padding-left: 0;
    padding-bottom: 14px;
  }
  .final-cta .acc-eyebrow::before {
    background: var(--rose);
    left: 50%;
    top: auto;
    bottom: 0;
    transform: translateX(-50%);
    width: 32px;
  }
  .final-cta h2 {
    color: #fff;
    font-size: clamp(32px, 4.4vw, 50px);
    margin-bottom: 22px;
    line-height: 1.2;
  }
  .final-cta > .container > .final-inner > p {
    font-size: 18px;
    color: rgba(255,255,255,0.85);
    line-height: 1.65;
    margin-bottom: 38px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .btn-final {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 36px;
    background: var(--orange);
    color: #fff !important;
    font-family: 'League Spartan', sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 50px;
    text-decoration: none;
    transition: all .3s;
  }
  .btn-final:hover { background: #f3966a; transform: translateY(-2px); text-decoration: none; }
  .btn-final span { transition: transform .25s; }
  .btn-final:hover span { transform: translateX(4px); }

  /* Newsletter im Final-CTA */
  .newsletter {
    margin-top: 80px;
    padding-top: 60px;
    border-top: 1px solid rgba(255,255,255,0.15);
  }
  .newsletter h3 {
    color: #fff;
    font-size: 26px;
    margin-bottom: 10px;
  }
  .newsletter p {
    color: rgba(255,255,255,0.8);
    font-size: 15px;
    margin-bottom: 22px;
  }
  .newsletter-form {
    display: flex;
    gap: 8px;
    max-width: 480px;
    margin: 0 auto;
  }
  .newsletter-form input {
    flex: 1;
    padding: 14px 20px;
    border-radius: 50px;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.08);
    color: #fff;
