---
// Intensiv-Coaching-Woche Pachyammos (Zypern) — Sales Page
// Nachbau der ClickFunnels-Archivseite (workshop.himmelstosscoaching.de/pachyammos-icw)
// Struktur exakt übernommen, Stil an die Fokus-Seiten angepasst (keine Emojis).
// ⚠️ Preis 4.200 € / Paar 5.700 € = Stand offers.ts (Single Source of Truth)
// ⚠️ Gesprächs-Link = Orientierungsgespräch-Kalender (aus FooterFokus); von A&H bestätigen lassen
import FokusLayout from '../layouts/FokusLayout.astro';
import HeaderFokus from '../components/HeaderFokus.astro';
import FooterFokus from '../components/FooterFokus.astro';
import WaveDivider from '../components/WaveDivider.astro';
import TidalWave from '../components/TidalWave.astro';

const gespraech = 'https://orientierungsgespraech-himmelstoss.youcanbook.me';

// Ablauf „Was passiert in dieser Woche" — Farbleiter Blau → Lachs-Orange (Stufen aus der Schatz-Kapitelleiter)
const woche = [
  { c: '#2C4B7B', t: 'Wir finden mit dir heraus, was deine wirkliche innere Vision ist — was du dir tief in deinem Inneren für dieses Leben vorgenommen hast.' },
  { c: '#5AA0C4', t: 'Wir lösen mit dir die festgefahrenen Muster und emotionalen Blockaden, die deiner Vision im Weg stehen. Dabei spielen meist Verletzungen aus der Kindheit oder Haltungen aus vorangehenden Leben eine Rolle.' },
  { c: '#E9B9C0', t: 'Am Ende der Woche wirst du nicht nur verstehen, was dich bisher zurückgehalten hat, sondern auch wissen, wie du es dauerhaft veränderst.' },
  { c: '#F89489', t: 'Du bekommst Werkzeuge für dein weiteres Leben. Diese Woche soll kein einmaliger „Schubser" sein, sondern eine nachhaltige Veränderung. Du gewinnst Klarheit, Leichtigkeit und neue Perspektiven.' },
  { c: '#FA9D56', t: 'Falls du in einer Beziehung bist: Du erkennst, warum ihr immer wieder in Konflikte geratet, wie du es lösen kannst — und wie ihr euch wirklich unterstützen könnt.' },
];

// „Was du aus dieser Woche mitnimmst"
const mitnehmen = [
  'Du verstehst, was dich bisher zurückgehalten hat, hast Blockaden gelöst und fühlst dich voller Energie.',
  'Du hast eine klare Richtung, weißt was du willst — und dadurch ein tiefes Gefühl von Sinnhaftigkeit.',
  'Veränderte Beziehungen — zu dir selbst, zu deinem Partner, zu deinem Umfeld. Du gehst mit neuer Offenheit und Tiefe auf deine Umgebung zu.',
  'Du erkennst deinen eigenen Wert und kannst dein Leben nach deinen Wünschen gestalten.',
  'Praktische Werkzeuge für deine Zukunft, um mit Herausforderungen umzugehen, ohne dich in alten Mustern zu verfangen.',
  'Falls du in einer Beziehung bist: Du weißt, wie ihr euch gegenseitig unterstützen könnt — statt euch unbewusst zu blockieren.',
];

// „Diese Woche ist für dich, wenn du …" — Kernwörter fett (Muster: Eignungs-Panel der Schatz-Seite)
const fuerDich = [
  '<strong>tief sitzende Blockaden</strong> endlich lösen willst — statt nur oberflächliche Lösungen zu suchen.',
  'das Gefühl hast, dass <strong>„mehr"</strong> in dir steckt, du aber nicht weißt, wie du es freisetzen kannst.',
  'endlich den <strong>roten Faden</strong> hinter deinen Problemen erkennen willst — um frei zu sein.',
  'in einer Beziehung bist und eine <strong>tiefere, unterstützende Verbindung</strong> erleben möchtest.',
  'einfach <strong>dein Leben in die Hand nehmen</strong> möchtest.',
];

// Galerie — 18 Bilder aus dem ClickFunnels-Archiv (14 Galerie + 4 Paradies).
// Reihenfolge NICHT mehr durchnummeriert, sondern nach gemessenem Farbanteil sortiert:
// Blau → Türkis → Grün → entsättigte Brücke → Warm. Folgt dem Sun-Strip der Marke.
// Gemessen 2026-07-17 im Browser (Durchschnitts-HSL + dominante Farbtonanteile pro Bild).
// Nach FORMAT gruppiert — innerhalb jeder Gruppe läuft der Farbverlauf Blau → Warm weiter.
// `gross` = halbe Rasterbreite (zwei nebeneinander) · `klein` = Palmen-Größe (269x600)
// `schnitt` = zugeschnitten auf 3/4 der Höhe
const galerie = [
  // ── Reihe 1–2: vier Querstreifen ─────────────────────────────────────────────
  { src: '/img/icw/galerie-08.jpg',  gross: true },              // Blau 44 % — stärkstes Blau
  { src: '/img/icw/galerie-05.jpg',  gross: true },              // Blau 39 %, hell
  { src: '/img/icw/galerie-06.jpg',  gross: true },              // Blau 25 % / Grün 19 %
  { src: '/img/icw/galerie-07.jpg',  gross: true },              // Blau 19 % / Grün 16 %
  // ── Reihe 3: die drei 3:2-Bilder (frühere letzte drei) — nach oben geholt ─────
  { src: '/img/icw/galerie-13.jpg',  schnitt: 'format32' },      // Himmel über Berg bleibt, Wiese unten gekürzt
  { src: '/img/icw/galerie-01.jpg' },                            // Blau 18 %, grünstichig
  { src: '/img/icw/galerie-02.jpg' },                            // Brücke (steht auch auf einer anderen Seite)
  // ── Reihe 4–5: die restlichen vier Querstreifen ──────────────────────────────
  { src: '/img/icw/galerie-04.jpg',  gross: true },              // entsättigt — Brücke
  { src: '/img/icw/galerie-03.jpg',  gross: true },              // warm 36 %, dunkel
  { src: '/img/icw/galerie-10.jpg',  gross: true },              // warm 20 %
  { src: '/img/icw/galerie-09.jpg',  gross: true },              // warm 36 %
  // ── Reihe 6: alle vier Hochformate in EINER Reihe · galerie-12 (vorher unterste) zuerst
  { src: '/img/icw/galerie-12.jpg',  klein: true },              // warm 17 % + Rosé
  { src: '/img/icw/galerie-14.jpg',  klein: true },              // Blau 42 % — volles Hochformat
  { src: '/img/icw/paradies-01.jpg', klein: true },              // Die Palme — Blau 42 %
  { src: '/img/icw/paradies-03.jpg', klein: true },              // Türkis 180°
  // Rausgenommen, Dateien bleiben liegen (Hinterhand): paradies-04, paradies-02, galerie-11
];

// Über Annette & Herbert
// Jahreszahlen stehen je genau EINMAL — keine Dauerangaben („30 Jahre"), die jedes Jahr veralten.
// Annette ist WEITERHIN Ärztin; beendet ist nur die Praxis (2021).
const ueberPunkte = [
  '<strong>Annette:</strong> Ärztin seit 1997 — bis 2021 mit eigener Praxis für individuelle Gesundheitswege, international aufgesucht: von traumatisierten Menschen bis zu schulmedizinisch austherapierten Patienten. Dieses Wissen ist nicht weg, es steckt heute im Coaching.',
  '<strong>Herbert:</strong> Vom Waffengeschäft über die Kunsttherapie zum Waldorflehrer — heute Sucht-Experte, mit einem Ansatz, den er selbst entwickelt hat: nicht Verbote, sondern die Frage dahinter — <em>Was sucht ein Mensch hinter der Droge?</em> Über zwanzigtausend Menschen hat er so begleitet.',
  '<strong>Seit 1992 verheiratet, drei inzwischen erwachsene Kinder:</strong> Wir kennen die Herausforderungen von Beziehungen und Familie — und wie man gemeinsam wächst, statt sich zu verlieren.',
  '<strong>Anthroposophische Grundlage:</strong> Wir arbeiten mit den Lehren Rudolf Steiners und beziehen spirituelle Dimensionen mit ein — immer mit dem Blick darauf, wie das im konkreten Alltag wirksam wird.',
  '<strong>Seit 2021:</strong> Wir haben unser Leben komplett verändert und sind unserer Vision gefolgt — und begleiten dich dabei, deinen Weg zu finden.',
];
---

<FokusLayout
  title="Intensiv-Coaching-Woche Zypern — Dein Weg zur tiefgehenden Transformation"
  description="Eine Woche Zypern, tiefes Coaching mit Annette & Herbert Himmelstoß. Zweimal täglich individuelle Prozesse, Vollpension am Meer. Für dich allein oder als Paar."
  canonical="https://himmelstosscoaching.de/intensiv-coaching-zypern"
>
  <HeaderFokus />

  <!-- 1 · HERO -->
  <section class="s-hero hero-fokus">
    <img class="hero-bg" src="/img/icw/hero-pomos.jpg" alt="Sonnenuntergang über dem Meer bei Pomos, Zypern — die Sonne steht auf dem Horizont, eine goldene Lichtbahn läuft über das Wasser" loading="eager" />
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <div class="hero-oben">
          <p class="hero-eyebrow">Retreat in Pachyammos · Zypern</p>
          <h1>Intensiv-Coaching-Woche</h1>
        </div>
        {/* Freiraum — hier steht im Foto die Sonne (gemessen: x 56%, y 52%). Bleibt leer. */}
        <div class="hero-sonnenfeld" aria-hidden="true"></div>
        <div class="hero-unten">
          <p class="hero-sub">Dein Weg zur <strong>tiefgehenden Transformation</strong> — allein oder als Paar.</p>
          <div class="hero-meta">
            <span>7 Tage · 6 Nächte</span>
            <span>Zweimal täglich Coaching</span>
            <span>Vollpension am Meer</span>
          </div>
          <a href={gespraech} class="btn btn-primary btn-lg" target="_blank" rel="noopener">Kostenfrei Orientierungs-Gespräch buchen →</a>
        </div>
      </div>
    </div>
    <TidalWave />
  </section>

  <!-- 2 · PROBLEM -->
  <section class="s-problem">
    <div class="container narrow">
      <h2 class="center">Fühlst du dich festgefahren, ohne zu wissen, warum?</h2>
      <p class="lead center">Hast du das Gefühl, dein Leben könnte so viel mehr sein — aber irgendetwas hält dich zurück?</p>
      <ul class="pain-list">
        <li>Du spürst eine anhaltende Unzufriedenheit. Vielleicht bist du oft gestresst, fühlst dich müde oder perspektivlos. Du möchtest etwas verändern, doch egal was du versuchst — es klappt einfach nicht.</li>
        <li>Du fühlst dich innerlich blockiert — aber weißt nicht, woher es kommt. Und du spürst, dass es mehr geben muss.</li>
        <li>Du hast Wünsche und Träume, die du seit Jahren aufschiebst, weil immer etwas dazwischenkommt.</li>
        <li>Du funktionierst — aber das Leben fühlt sich an, als würde es an dir vorbeiziehen.</li>
        <li>Oder du hast sich wiederholende Konflikte in deiner Beziehung, die euch immer wieder in alte Muster zurückwerfen.</li>
      </ul>
      <p class="center problem-close"><em>Du versuchst, es mit Willenskraft zu lösen — aber es fühlt sich an, als ob du gegen eine unsichtbare Wand rennst.</em></p>
    </div>
    <WaveDivider fill="var(--bg-cream)" />
  </section>

  <!-- 3 · LÖSUNG / ES GIBT EINEN WEG -->
  <section class="s-weg">
    <div class="container narrow center">
      <p class="acc-eyebrow" style="justify-content:center">Es gibt einen Weg</p>
      <p class="lead">Wir sind wie gelenkt durch unbewusste Glaubenssätze, alte Verletzungen und emotionale Blockaden. Sie sorgen dafür, dass du im Kreis läufst, dich immer wieder in denselben Mustern verfängst — und dich fragst, warum du nicht weiterkommst.</p>
      <h2>Die Intensiv-Coaching-Woche</h2>
      <p>Eine Woche, die dein Leben nachhaltig, tiefgehend und effektiv verändern kann — egal ob du allein oder ihr als Paar kommt.</p>

      <!-- Einführungs-/Erklärungsvideo — Bunny b4251ecf-ec20-4e72-911d-ae1af0ddecaf -->
      <div class="video-embed">
        <iframe src="https://iframe.mediadelivery.net/embed/708695/b4251ecf-ec20-4e72-911d-ae1af0ddecaf?autoplay=false&preload=true&responsive=true" title="Einführungsvideo zur Intensiv-Coaching-Woche" loading="lazy" frameborder="0" allow="fullscreen; picture-in-picture" allowfullscreen></iframe>
      </div>
      <a href={gespraech} class="btn btn-primary" target="_blank" rel="noopener">Jetzt Orientierungs-Gespräch buchen →</a>
    </div>
    <WaveDivider fill="var(--bg-white)" />
  </section>

  <!-- 4 · WAS PASSIERT IN DIESER WOCHE -->
  <section class="s-passiert">
    <div class="container narrow">
      <h2 class="center">Was passiert in dieser Woche?</h2>
      <ul class="check-list woche-list">
        {woche.map((w) => <li style={`--wc: ${w.c}`}>{w.t}</li>)}
      </ul>
      <blockquote class="pull-quote">„Es übertrifft alles, was ich mir vorstellen konnte."<cite>— Heike</cite></blockquote>
    </div>
    <WaveDivider fill="var(--bg-cream)" />
  </section>

  <!-- 5 · WAS DU MITNIMMST -->
  <section class="s-mitnehmen">
    <div class="container">
      <h2 class="center">Was du aus dieser Woche mitnimmst</h2>
      <div class="mit-grid">
        {mitnehmen.map((m) => (
          <div class="mit-card"><p>{m}</p></div>
        ))}
      </div>
      <blockquote class="pull-quote center">„Ich habe eine Woche erlebt, wie ich sie niemals erwartet hätte."<cite>— Gabriele</cite></blockquote>
    </div>
    <WaveDivider fill="var(--bg-white)" />
  </section>

  <!-- 6 · DU STEHST IM MITTELPUNKT / ABLAUF -->
  <section class="s-ablauf">
    <div class="container ablauf-grid">
      <div class="ablauf-text">
        <p class="acc-eyebrow">Du stehst im Mittelpunkt</p>
        <h2>Wir sind die ganze Woche für dich da</h2>
        <p>Zweimal täglich begleiten wir dich mit individuellen Coaching-Prozessen, um dein mitgebrachtes Thema zu lösen und nachhaltige Veränderungen zu ermöglichen.</p>
        <p>Dazwischen hast du genügend Raum, um das Erlebte nachklingen zu lassen, es zu verankern und die wundervolle Natur Zyperns zu genießen: mit einem Bad im Meer, einem Spaziergang am Strand oder in den Bergen.</p>
        <p>Wir unternehmen mit dir auch kleine Ausflüge in die umliegenden Orte und an den Hafen — so, wie es für dich stimmig ist und deinen Prozess unterstützt.</p>
      </div>
      <div class="ablauf-img ablauf-img--haus">
        <img src="/img/icw/haus-zypern.jpg" alt="Terrasse mit Engelsbrunnen, Bougainvillea und blauen Stühlen — unser Haus in Pachyammos" loading="lazy" />
      </div>
    </div>

    <div class="container ablauf-grid reverse">
      <div class="ablauf-img ablauf-img--essen">
        <img src="/img/icw/verpflegung.jpg" alt="Tisch voller frischer Früchte: Orangen, Zitronen, Mandarinen, Granatäpfel und Pflaumen" loading="lazy" />
      </div>
      <div class="ablauf-text">
        <h3>Unterkunft &amp; Verpflegung</h3>
        <p>Du genießt während deines Aufenthalts eine liebevolle Rundum-Versorgung mit Vollpension. Herbert ist ein ausgezeichneter Koch — wir besprechen gerne vorab deine Essenswünsche, Unverträglichkeiten oder besonderen Vorlieben mit dir.</p>
        <p>Du schläfst in einem kleinen Gästezimmer mit Meerblick; zusätzlich stehen dir diverse Sitzplätze in und um das Haus zur Verfügung.</p>
      </div>
    </div>
    <WaveDivider fill="var(--bg-cream)" />
  </section>

  <!-- 7 · FÜR WEN / CHANCE -->
  <section class="s-fuer">
    <div class="container narrow">
      <h2 class="center">Diese Woche ist für dich, wenn du …</h2>
      <div class="fuer-panel">
        <ul class="fuer-list">
          {fuerDich.map((f) => <li set:html={f} />)}
        </ul>
      </div>
      <div class="chance-box">
        <p>Das ist deine Chance, dein Leben wirklich zu verändern.</p>
        <ul>
          <li>Kein weiteres Jahr, in dem du dich mit denselben Problemen herumschlägst.</li>
          <li>Kein weiteres Warten, bis sich „irgendwas von selbst ändert".</li>
          <li>Keine weiteren Versuche, „es allein zu schaffen" — während du dich weiterhin festgefahren fühlst.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 8 · TESTIMONIALS -->
  <section class="s-testimonials">
    <div class="container">
      <p class="acc-eyebrow" style="justify-content:center">Was Teilnehmer erlebt haben</p>
      <h2 class="center">Erfahrungen aus der Woche</h2>

      <div class="testi-cols">
        <!-- Spalte 1 -->
        <div class="testi-col">
          <blockquote class="testi">
            <!-- Video-Testimonial Frank M — Bunny 5a2ec602-2581-489e-b552-5566990f3ca9 -->
            <div class="video-embed"><iframe src="https://iframe.mediadelivery.net/embed/708695/5a2ec602-2581-489e-b552-5566990f3ca9?autoplay=false&preload=true&responsive=true" title="Video-Testimonial Frank M." loading="lazy" frameborder="0" allow="fullscreen; picture-in-picture" allowfullscreen></iframe></div>
            <p class="stars" aria-label="5 von 5 Sternen">★★★★★</p>
            <p class="testi-head">„…das Leben ist schön!"</p>
            <p>„Ich kam ohne Erwartungen — und ging mit einer Klarheit, die mein Leben verändern wird. Diese Woche war ein Geschenk voller Herzlichkeit, Tiefe und echtem Aufbruch."</p>
            <cite>Frank M.</cite>
          </blockquote>

          <blockquote class="testi">
            <img class="testi-portrait-img" src="/img/icw/ingeborg.jpg" alt="Ingeborg" loading="lazy" />
            <p class="stars" aria-label="5 von 5 Sternen">★★★★★</p>
            <p class="testi-head">„…besonders berührt hat mich die Selbstverständlichkeit, mit der ich aufgenommen wurde"</p>
            <p>„Ich kam ohne konkrete Fragen, ohne Erwartungen, nur mit dem Gefühl, in einer Sackgasse zu stecken. Und so fingen wir an. Wir sprachen, wir erzählten aus unserem Leben — es war ein Raum voller Vertrauen, in dem ich wirklich alles ansprechen konnte, ohne Scham.</p>
            <p>Was mich besonders berührt hat, war die Selbstverständlichkeit, mit der ich aufgenommen wurde — in den Alltag, am Tisch, in den Gesprächen. Obwohl ich „im Mittelpunkt" stand, war ich kein Gast, ich war Teil. Das hat mir erlaubt, mich wirklich zu öffnen — so tief, wie ich es selten erlebt habe.</p>
            <p>Am Ende dieser Woche hatte ich mehr Akzeptanz für mich selbst, mehr Verständnis für meine Phasen. Am letzten Tag kam mir ein Bild, das die Woche zusammenfasst: Ich lag als Kleinkind in der Kuhle eines runden Bettchens, von zwei Seiten liebevoll behütet. Und jetzt kann ich weiter wachsen …"</p>
            <cite>Ingeborg</cite>
          </blockquote>
        </div>

        <!-- Spalte 2 -->
        <div class="testi-col">
          <blockquote class="testi">
            <!-- Video-Testimonial Gabriele W — Bunny 3eefa85a-9489-448f-9db2-5a3075a0b78c -->
            <div class="video-embed"><iframe src="https://iframe.mediadelivery.net/embed/708695/3eefa85a-9489-448f-9db2-5a3075a0b78c?autoplay=false&preload=true&responsive=true" title="Video-Testimonial Gabriele W." loading="lazy" frameborder="0" allow="fullscreen; picture-in-picture" allowfullscreen></iframe></div>
            <p class="stars" aria-label="5 von 5 Sternen">★★★★★</p>
            <p class="testi-head">„…Vertrauen zu finden, aus mir heraus mein Leben zu gestalten"</p>
            <p>„Diese Woche ist ein Rundum-Paket. Die individuelle Unterstützung von Annette und Herbert ist unglaublich."</p>
            <cite>Gabriele W.</cite>
          </blockquote>

          <blockquote class="testi">
            <!-- Video-Testimonial Trixi — Bunny 4262dc90-75e7-4727-ae50-0fca9553dec1 -->
            <div class="video-embed"><iframe src="https://iframe.mediadelivery.net/embed/708695/4262dc90-75e7-4727-ae50-0fca9553dec1?autoplay=false&preload=true&responsive=true" title="Video-Testimonial Trixi" loading="lazy" frameborder="0" allow="fullscreen; picture-in-picture" allowfullscreen></iframe></div>
            <p class="testi-head">„Ich bin richtig, wie ich bin."</p>
            <p>„Diese eine Erkenntnis hat für mich alles verändert. In der Coaching-Woche durfte ich zum ersten Mal wirklich alles aussprechen — ohne bewertet zu werden, ohne Ratschläge, einfach gehört werden. Tiefe Themen aus meiner Kindheit, alte Muster durften ans Licht kommen. Und plötzlich wurde klar: Es gibt ein Hauptthema — und wenn man da hinschaut, verändert sich so viel.</p>
            <p>Ich habe gelernt, dass meine Reaktionen Sinn machen. Diese Woche hat mir Zuversicht gegeben und eine neue Haltung mir selbst gegenüber. Kein Mangeldenken mehr, kein ständiges Funktionieren. Sondern echte Verbindung — mit mir."</p>
            <cite>Trixi</cite>
          </blockquote>
        </div>

        <!-- Spalte 3 -->
        <div class="testi-col">
          <blockquote class="testi">
            <!-- Video-Testimonial Heike — Bunny 848a6078-efe7-42c5-a210-c4d6a9e6b41d -->
            <div class="video-embed"><iframe src="https://iframe.mediadelivery.net/embed/708695/848a6078-efe7-42c5-a210-c4d6a9e6b41d?autoplay=false&preload=true&responsive=true" title="Video-Testimonial Heike" loading="lazy" frameborder="0" allow="fullscreen; picture-in-picture" allowfullscreen></iframe></div>
            <p class="stars" aria-label="5 von 5 Sternen">★★★★★</p>
            <p class="testi-head">„…so intensiv habe ich mir das nicht vorgestellt"</p>
            <p>„Dieses Coaching ist für Menschen, die den Mut haben, ihr Leben in die Hand zu nehmen und alte Muster und Strukturen, die ihnen dabei im Wege stehen, beiseite räumen wollen."</p>
            <cite>Heike</cite>
          </blockquote>

          <blockquote class="testi">
            <img class="testi-portrait-img" src="/img/icw/christian.png" alt="Christian" loading="lazy" />
            <p class="testi-head">„…warum haben wir nie gelernt, mit unseren Gefühlen umzugehen?"</p>
            <p>„Ich habe erkannt, dass mein schlechtes Gewissen nur ein selbst erschaffenes Programm war — niemand leidet, wenn ich auf mich höre. Indem ich meine Emotionen zulasse, statt gegen sie zu kämpfen, haben sich Unruhe und Zweifel in Vertrauen und innere Freiheit verwandelt. Tiefpunkte sind keine Sackgassen mehr, sondern Absprünge für den nächsten Aufstieg. Ich kann meine Realität aktiv gestalten — und das fühlt sich so gut an."</p>
            <cite>Christian</cite>
          </blockquote>
        </div>
      </div>
    </div>
    <TidalWave />
  </section>

  <!-- 9 · HAUPTANGEBOT / CTA -->
  <section class="s-angebot" id="angebot">
    <div class="container narrow center">
      <p class="eyebrow-light">Dein Platz</p>
      <h2 class="angebot-hl">Diese Woche ist ein Schlüssel zur echten Veränderung</h2>
      <p class="angebot-intro">Wenn du spürst, dass jetzt die richtige Zeit ist, dann laden wir dich herzlich ein, mit uns diese Woche zu erleben.</p>

      <div class="angebot-card">
        <dl class="angebot-facts">
          <div><dt>Ort</dt><dd>Unser Haus in Zypern (alternativ eine nahegelegene Unterkunft oder exklusiv im 4-Sterne-Hotel)</dd></div>
          <div><dt>Dauer</dt><dd>7 Tage · 6 Nächte</dd></div>
          <div><dt>Inklusive</dt><dd>Tägliche intensive Sitzungen, Vollpension, eine entspannte und unterstützende Umgebung</dd></div>
          <div><dt>Invest</dt><dd><strong>einzeln 4.200 €</strong> · als Paar 5.700 €</dd></div>
        </dl>
