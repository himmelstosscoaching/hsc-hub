/* Einzeilig: Die Zeile ist ~930px breit — deshalb .hero-text auf 980px und die Größe
   so gedeckelt, dass sie hineinpasst. Auf schmalen Fenstern darf sie wieder umbrechen. */
.hero-sub { font-size: clamp(23px,2.4vw,29px); color: var(--hero-ink-dunkel); margin: 0 0 14px; line-height: 1.5; text-shadow: 0 1px 16px rgba(255,252,245,0.85); }
@media (min-width: 1100px) { .hero-sub { white-space: nowrap; } }
