---
// 12 heilige Nächte — saisonale Info-/Verkaufsseite (Live-Workshop, 12 Zoom-Termine).
// Verlinkt von /angebote. Bezahlung über Digistore (kein Online-Kurs → kein ThriveCart nötig).
// Texte 1:1 übernommen von der alten WordPress-Seite (himmelstosscoaching.de/12-heilige-nachte),
// Jahreszahlen auf die Edition 2026/2027 aktualisiert. Stand 2026-06.
import FokusLayout from '../layouts/FokusLayout.astro';
import HeaderFokus from '../components/HeaderFokus.astro';
import FooterFokus from '../components/FooterFokus.astro';
import WaveDivider from '../components/WaveDivider.astro';
import TidalWave from '../components/TidalWave.astro';
import FounderTrust from '../components/FounderTrust.astro';

// 🔴 TODO (Christian): Digistore-Checkout für Edition 2026/2027 NEU anlegen — es existiert nur die 2025er-Version.
//    Produkt 577723 (alter Link) ist die MONATSAUSRICHTUNG, NICHT die Heiligen Nächte → darf NICHT live gehen.
//    Sobald das neue Produkt steht: Checkout-Link hier eintragen, Gutschein (z. B. „weihnachten-2026“) im Produkt anlegen.
// Zwischenlösung (bis der echte Checkout steht): Buttons führen zu einer vorbereiteten
//    Anmelde-Mail statt ins Leere — kein falsches Produkt, aber Interessenten können sich melden.
const buchenUrl = 'mailto:kontakt@himmelstosscoaching.de?subject=12%20heilige%20N%C3%A4chte%202026%2F2027%20%E2%80%94%20ich%20bin%20dabei';

// Abwechselnde Bild-Text-Blöcke (Bild links / rechts / links)
const bloecke = [
  {
    img: '/img/heilige-naechte/Himmelstoss_Start_Rauhnaechte-2.jpg',
    alt: 'Stimmungsvolle Rauhnächte zwischen den Jahren',
    rev: false,
    veil: 'blue-left',
    titel: 'Warum gerade jetzt?',
    text: [
      'Die Rauhnächte sind eine Zeit wie keine andere: Die zwölf Nächte zwischen Weihnachten und Neujahr sind eine Zeit, in der die Grenze zwischen Jenseits und Diesseits sehr durchlässig ist. Damit gelingt es leichter als sonst, an seine tiefen inneren Impulse anzuschließen.',
      'In diesem exklusiven Workshop lernst du, deine 12 persönlichen Botschaften zu empfangen, um im kommenden Jahr das zu leben, was schon lange in deinem Inneren anklopft. Die Botschaften helfen dir, Monat für Monat den Weg in das Leben zu finden, das du wirklich leben willst.',
    ],
  },
  {
    img: '/img/heilige-naechte/Himmelstoss_Rauhnaechte_Header-2.jpg',
    alt: 'Sonnenaufgang über einer winterlichen Landschaft',
    rev: true,
    veil: 'warm-right',
    titel: 'Das erwartet dich im Workshop',
    items: [
      ['Die freie Meditation', 'Den zentralen Raum nimmt die freie Meditation ein, durch die ich dich jeden Morgen führe. Sie ist mein Impuls aus der Nacht – jeden Tag empfange ich neu, was kommt.'],
      ['Deine persönlichen Morgenbotschaften', 'Du lernst, deine persönlichen Botschaften zu empfangen, die dein Begleiter für das Jahr 2027 werden.'],
      ['Gemeinschaft und Kraftfeld der Zuversicht', 'Spüre die Stärke und Ruhe einer Gruppe Gleichgesinnter, die sich mit dir auf die Reise macht und gemeinsam ein kraftvolles Licht in die Welt bringt.'],
      ['Spirituelle Impulse der Tierkreiszeichen', 'Entdecke, wie jeder Tag dieser besonderen Zeit mit einer Tierkreisenergie aufgeladen ist. Rudolf Steiners Sprüche begleiten uns und entfalten ihre inspirierende Kraft.'],
    ],
  },
  {
    img: '/img/heilige-naechte/Himmelstoss_Rauhnaechte.jpg',
    alt: 'Kerzenlicht und Stille in den heiligen Nächten',
    rev: false,
    veil: 'warm-left',
    titel: 'Warum dieser Workshop deine Chance ist',
    text: [
      'Hast du genug von den endlosen Wiederholungen und Stillständen?',
      'Wünschst du dir, voller Vorfreude in das neue Jahr zu starten?',
      'Dieser Workshop gibt dir die Werkzeuge, die Klarheit und den Schub, den du brauchst – um das neue Jahr nicht nur zu begrüßen, sondern mit Zuversicht und voller Freude zu gestalten!',
    ],
  },
];

const leistungen = [
  '12 Live-Treffen täglich von 09.00 bis 10.00 Uhr im Gruppen-Zoom',
  'vom 25.12.2026 bis zum 05.01.2027',
  'Du kannst einmal nicht dabei sein? Du bekommst eine Aufzeichnung.',
  'Tierkreisspruch zu jedem Tag',
  'Tägliche Meditation zu den Tagesthemen',
  'Zeit für individuelle Rückschau und Vorblick',
  'Austausch und Gespräch in der Gruppe',
  'Du lernst, deine eigenen Morgenbotschaften zu empfangen',
  'Du bekommst ein Workbook, das dich das ganze Jahr 2027 begleitet',
];

// Preisstufen als Zeitleiste: sichtbar ist immer nur der Preis, der heute gilt.
// „bis“ = letzter Tag der Stufe (ISO). Die letzte Stufe laeuft ohne Ende.
const preisstufen = [
  { tag: 'Frühbucherpreis', preis: '240 €', bis: '2026-11-15', frist: 'Nur bis 15. November', ab: '' },
  { tag: 'Aktionspreis',    preis: '270 €', bis: '2026-12-10', frist: 'Nur bis 10. Dezember', ab: 'Ab 16. November' },
  { tag: 'Regulärer Preis', preis: '330 €', bis: null,         frist: '',                     ab: 'Ab 11. Dezember' },
];

const heute = new Date().toISOString().slice(0, 10);
const aktivIndex = Math.max(0, preisstufen.findIndex((p) => !p.bis || heute <= p.bis));
const aktiv = preisstufen[aktivIndex];
// Ruhige Zeile darunter: was danach kommt — Transparenz ohne Vergleichsarbeit.
const staffelText = preisstufen
  .slice(aktivIndex + 1)
  .map((p) => `${p.ab} ${p.preis}`)
  .join(' · ');

const stimmen = [
  {
    text: 'Eure Präsenz gibt Sicherheit. Die Balance zwischen Freilassen und Begleiten habt ihr für mich optimal getroffen. Dies ermöglicht das Entdecken der eigenen Persönlichkeit bis zum innersten Kern und das Finden von individuellen Lösungs-Möglichkeiten in jeder Lebenssituation. Ich grüße euch – von Herzen.',
    name: 'Claudia Bischof',
  },
  {
    text: 'Es ist ein schöner, innerer und äußerer Rhythmus entstanden, der durch den Tag getragen hat. Das vergangene Jahr wurde in kleinen Schritten nochmal angeschaut und die Betrachtung legte den Grundstein für die kommenden Monate. Ich bin viel wacher durch die Tage gegangen.',
    name: 'Anke Spiess',
  },
  {
    text: 'Unter der weisen Anleitung von Herbert und Annette haben wir uns gegenseitig sehr bereichern können. Das Erkennen unserer Lebensabsichten und Lebensziele war ein so wichtiger Schritt dabei – jedoch auch, dass wir tun, was uns wirklich Freude macht! Danke, danke, danke!',
    name: 'Anita Peters',
  },
  {
    text: 'Die 12 Heiligen Nächte mit dem täglichen Webinar waren für mich Ausnahmetage, geschenkte Tage, außerhalb des normalen Jahresverlaufs. Ganz besonders war für mich die Erfahrung, Morgenbotschaften zu empfangen. Was da durch mich durchgeflossen ist und nachher auf dem Papier stand, hat mich täglich neu erstaunt!',
    name: 'Veronika Sudhoff',
  },
];
---

<FokusLayout
  title="Die 12 heiligen Nächte — Rauhnächte einmal anders | Himmelstoß Coaching"
  description="Ein geführter Live-Workshop durch die zwölf heiligen Nächte (25.12.2026 – 05.01.2027): täglich Meditation, Tierkreisspruch und deine persönlichen Morgenbotschaften für ein neues Jahr voller Klarheit. Mit Annette & Herbert Himmelstoß."
  canonical="https://himmelstosscoaching.de/12-heilige-naechte"
>
  <HeaderFokus />

  <!-- 1 · HERO -->
  <section class="hn-hero">
    <img class="hn-hero-snow hn-hero-snow--left" src="/img/heilige-naechte/Schnee-Tannen.jpeg" alt="" aria-hidden="true" loading="eager" />
    <img class="hn-hero-snow hn-hero-snow--right" src="/img/heilige-naechte/Schnee-Wald.jpeg" alt="" aria-hidden="true" loading="eager" />
    <div class="container hn-hero-inner">
      <p class="hn-eyebrow">Online-Workshop · 12 Live-Treffen</p>
      <h1>Die 12 heiligen Nächte<br><em>Jede Nacht ein Monat. Jeder Morgen eine Botschaft.</em><br><span class="hn-h1-sub">Rauhnächte einmal anders.</span></h1>
      <p class="hn-dates">vom 25.12.2026 – 05.01.2027</p>
      <a href={buchenUrl} class="btn btn-primary btn-lg">Jetzt anmelden →</a>
    </div>
  </section>

  <!-- 2 · INTRO -->
  <section class="hn-intro">
    <div class="container narrow center">
      <h2>Starte dein Jahr 2027 mit deinen persönlichen Botschaften!</h2>
      <p>
        Erlebe in den 12 Heiligen Nächten deinen Neustart – erhalte in der transformierenden
        Energie zwischen den Jahren deine persönlichen Botschaften, die das kommende Jahr zu einem
        Jahr voller Wachstum, Klarheit und Durchbruchs-Momente machen!
      </p>
    </div>
    <TidalWave />
  </section>

  <!-- Pull-Quote · stimmungsvoll -->
  <section class="hn-pull">
    <div class="container narrow">
      <span class="hn-pull-mark" aria-hidden="true"></span>
      <p>Zwölf Nächte, in denen die Grenze dünn wird.</p>
    </div>
  </section>

  <!-- 3 · ABWECHSELNDE BILD-TEXT-BLÖCKE -->
  <section class="hn-blocks">
    <div class="container">
      {bloecke.map((b) => (
        <div class:list={['hn-block', { 'hn-block--rev': b.rev }]}>
          <div class:list={['hn-block-img', b.veil]}>
            <img src={b.img} alt={b.alt} loading="lazy" />
          </div>
          <div class="hn-block-text">
            <h2>{b.titel}</h2>
            {b.text && b.text.map((p) => <p>{p}</p>)}
            {b.items && (
              <ul class="hn-feature-list">
                {b.items.map(([titel, beschr]) => (
                  <li><strong>{titel}</strong><span>{beschr}</span></li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Pull-Quote · Aneignung -->
  <section class="hn-pull hn-pull--alt">
    <div class="container narrow">
      <span class="hn-pull-mark" aria-hidden="true"></span>
      <p>Damit das neue Jahr deins wird.</p>
    </div>
  </section>

  <!-- 4 · LEISTUNGEN -->
  <section class="hn-leistungen">
    <TidalWave top />
    <div class="container narrow">
      <h2 class="center">Das erwartet dich in den zwölf Nächten</h2>
      <ul class="hn-facts">
        {leistungen.map((l) => <li>{l}</li>)}
      </ul>
    </div>
    <WaveDivider fill="var(--bg-cream)" />
  </section>

  <FounderTrust />

  <!-- 5 · PREISE -->
  <section class="hn-preise">
    <div class="container narrow center">
      <p class="eyebrow-light hn-eyebrow-light">Einmal bezahlen und als Familie dabei</p>
      <h2 class="hn-preis-hl">Sei dabei</h2>
      <div class="hn-preis-jetzt" data-preisblock data-stufen={JSON.stringify(preisstufen)}>
        <p class="hn-preis-tag" data-preis-tag>{aktiv.tag}</p>
        <div class="hn-preis-haupt" data-preis-wert>{aktiv.preis}</div>
        <p class="hn-preis-frist" data-preis-frist>{aktiv.frist}</p>
      </div>
      <p class="hn-preis-staffel" data-preis-staffel>{staffelText}</p>
      <a href={buchenUrl} class="btn btn-primary btn-lg hn-preis-btn">Ja, ich bin dabei →</a>
    </div>
  </section>

  <!-- 6 · PERSÖNLICHE ERFAHRUNGEN -->
  <section class="hn-erfahrung">
    <div class="container narrow">
      <h2 class="center">Persönliche Erfahrungen</h2>
      <p class="hn-erfahrung-intro">
        Seit vielen Jahren beobachten wir, dass die Zeit der 12 heiligen Nächte eine ganz besondere
        Qualität hat. Darum nehmen wir uns in dieser Zeit bewusst den Raum, den Alltag weitgehend
        loszulassen und sind aufmerksam, was uns in diesen Tagen begegnet. Vor 10 Jahren gelang uns
        das aufgrund des Umzuges unserer Schwieger-/Eltern nicht. Es war deutlich zu erleben, dass
        uns in der folgenden Zeit Kraft und Energie fehlten.
      </p>

      <figure class="hn-voice">
        <img src="/img/heilige-naechte/Himmelstoss_Annette-2.png" alt="Annette Himmelstoß" loading="lazy" />
        <blockquote>
          <p>Wir leben in einer Zeit, die versucht, uns durch Angst vor der Zukunft, Angst vor Krankheit, vor Armut, vor Krieg zu lenken, zu manipulieren. Umso intensiver wir lernen, in Verbindung mit der höheren Welt zu sein, umso mehr entsteht das Vertrauen, im Leben geführt zu werden. Es breitet sich Ruhe in uns aus.</p>
          <p>In der Gemeinschaft diese Themen zu bewegen und zu meditieren, hat eine sehr große Kraft, die weit über uns hinausgeht. Genau deshalb ist es mir ein großes Anliegen, die 12 heiligen Nächte in dieser Weise gemeinsam zu begehen.</p>
          <figcaption>— Annette Himmelstoß</figcaption>
        </blockquote>
      </figure>

      <figure class="hn-voice hn-voice--rev">
        <img src="/img/heilige-naechte/Himmelstoss_Herbert-1.png" alt="Herbert Himmelstoß" loading="lazy" />
        <blockquote>
          <p>Monat für Monat auf das alte Jahr zu blicken, mit dem Gesichtspunkt der Tierkreiskräfte, bringt jedes Mal neue und sinnvolle Aspekte, um das Geschehene zu verstehen. Daraus ergeben sich wiederum Gestaltungsimpulse für das kommende Jahr.</p>
          <p>Eine Besinnungstätigkeit, die den 12 heiligen Nächten entspricht und von ihnen getragen wird. Ein seelisches Atemholen für das ganze neue Jahr.</p>
          <figcaption>— Herbert Himmelstoß</figcaption>
        </blockquote>
      </figure>
    </div>
  </section>

  <!-- 7 · TEILNEHMERSTIMMEN -->
  <section class="hn-stimmen">
    <div class="container">
      <p class="acc-eyebrow" style="justify-content:center">Teilnehmerstimmen</p>
      <h2 class="center">Was Teilnehmer erlebt haben</h2>
      <div class="hn-stimmen-grid">
        {stimmen.map((s) => (
          <blockquote class="hn-stimme">
            <p>{s.text}</p>
            <cite>{s.name}</cite>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- 8 · FINAL CTA — ohne Foto, nur Blau→Türkis→Warm-Verlauf -->
  <section class="hn-final">
    <div class="container narrow center">
      <h2 class="hn-final-hl">Die 12 heiligen Nächte – Rauhnächte einmal anders</h2>
      <p class="hn-final-dates">vom 25.12.2026 – 05.01.2027</p>
      <a href={buchenUrl} class="btn btn-primary btn-lg">Ja, ich bin dabei →</a>
    </div>
  </section>

  <FooterFokus />
</FokusLayout>

<script>
  // Der Preis wird beim Build gesetzt. Ohne neuen Build waere er nach dem
  // 15.11. bzw. 10.12. falsch — deshalb hier im Browser noch einmal anhand
  // des heutigen Datums nachgezogen.
  const block = document.querySelector('[data-preisblock]');
  if (block instanceof HTMLElement && block.dataset.stufen) {
    const stufen = JSON.parse(block.dataset.stufen);
    const heute = new Date().toISOString().slice(0, 10);
    let i = stufen.findIndex((s) => !s.bis || heute <= s.bis);
    if (i < 0) i = stufen.length - 1;
    const aktiv = stufen[i];
    const setzen = (sel, text) => {
      const el = document.querySelector(sel);
      if (el) el.textContent = text;
    };
    setzen('[data-preis-tag]', aktiv.tag);
    setzen('[data-preis-wert]', aktiv.preis);
    setzen('[data-preis-frist]', aktiv.frist);
    setzen(
      '[data-preis-staffel]',
      stufen.slice(i + 1).map((s) => `${s.ab} ${s.preis}`).join(' · ')
    );
  }
</script>

<style>
  /* ── HERO ─────────────────────────────────────────────────── */
  /* Hero: oben gekuerzt (weniger Blau vor dem Text), Schriftblock sitzt tiefer
     im Bild — der leere Verlauf unter dem Button wird dafuer kleiner. */
  .hn-hero { position: relative; min-height: clamp(300px, 36vh, 420px); padding: clamp(48px,5vw,64px) 0 clamp(64px,8vw,96px); display: flex; align-items: center; overflow: hidden; text-align: center; background: linear-gradient(180deg, #1c4062 0%, #21476b 20%, #2783ac 40%, #4f9fc4 56%, #75bfda 70%, #9cc4cf 80%, #c9b8b4 89%, #e6af96 95%, #f4a366 100%); }
  .hn-hero-snow { position: absolute; top: 0; height: 100%; width: clamp(260px, 40%, 580px); object-fit: cover; object-position: center; opacity: 0.32; pointer-events: none; mix-blend-mode: screen; }
  .hn-hero-snow--right { right: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,0.4) 40%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,0.4) 40%, #000 100%); }
  .hn-hero-snow--left { left: 0;
    -webkit-mask-image: linear-gradient(270deg, transparent 0%, rgba(0,0,0,0.4) 40%, #000 100%);
    mask-image: linear-gradient(270deg, transparent 0%, rgba(0,0,0,0.4) 40%, #000 100%); }
  .hn-hero-inner { position: relative; z-index: 2; width: 100%; padding: clamp(80px,10vw,120px) 0 clamp(40px,6vw,60px); margin-top: 0; }
  .hn-eyebrow { font-family: var(--font-body); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; font-size: clamp(13px,1.3vw,16px); color: rgba(255,255,255,0.92); margin: 0 0 18px; text-shadow: 0 1px 12px rgba(20,35,60,0.55); }
  .hn-hero h1 { color: #fff; font-size: clamp(36px,5.4vw,66px); line-height: 1.08; margin: 0 0 18px; text-shadow: 0 2px 22px rgba(15,28,50,0.65); }
  .hn-hero h1 em { display: block; font-style: italic; color: var(--orange); font-size: 0.68em; margin-top: 12px; text-shadow: 0 2px 18px rgba(15,28,50,0.6); }
  .hn-hero h1 .hn-h1-sub { display: block; font-family: var(--font-display); font-style: italic; font-weight: 400; color: #fff; font-size: 0.52em; margin-top: 8px; text-shadow: 0 2px 16px rgba(15,28,50,0.6); }
  .hn-dates { font-family: var(--font-display); font-style: italic; font-size: clamp(18px,2vw,24px); color: rgba(255,255,255,0.95); margin: 0 0 30px; text-shadow: 0 1px 14px rgba(15,28,50,0.6); }

  /* ── INTRO ────────────────────────────────────────────────── */
  .hn-intro { background: var(--bg-white); padding: clamp(60px,8vw,100px) 0; }
  .hn-intro h2 { color: var(--blue-deep); font-size: clamp(24px,2.8vw,38px); line-height: 1.2; margin: 0 0 22px; }
  .hn-intro p { font-size: clamp(17px,1.6vw,21px); color: var(--ink-soft); line-height: 1.7; margin: 0 auto; max-width: 640px; }

  /* ── PULL-QUOTES (hervorgehobene Statements) ──────────────── */
  .hn-pull { background: var(--bg-white); padding: clamp(52px,7vw,92px) 0; text-align: center; }
  .hn-pull-mark { display: block; width: 56px; height: 3px; background: var(--orange); margin: 0 auto 26px; border-radius: 2px; }
  .hn-pull p { font-family: var(--font-display); font-style: italic; font-size: clamp(26px,3.4vw,44px); line-height: 1.25; color: var(--blue-deep); max-width: 720px; margin: 0 auto; }
  .hn-pull--alt { padding: clamp(36px,5vw,64px) 0; }

  /* ── BILD-TEXT-BLÖCKE ─────────────────────────────────────── */
  .hn-blocks { background: var(--bg-cream); padding: clamp(20px,4vw,40px) 0 clamp(40px,6vw,80px); }
  .hn-block { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px,5vw,72px); align-items: center; padding: clamp(36px,5vw,60px) 0; }
  .hn-block--rev .hn-block-img { order: 2; }
  .hn-block-img { position: relative; }
  .hn-block-img img { width: 100%; border-radius: var(--radius-card); box-shadow: var(--shadow-card); display: block; aspect-ratio: 4 / 3; object-fit: cover; }
  /* Farbschleier läuft vom äußeren Rand ins Bild, zur Mitte hin auslaufend (wie in der Vorlage) */
  .hn-block-img::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-card); pointer-events: none; }
  .hn-block-img.blue-left::after  { background: linear-gradient(90deg,  rgba(44,75,123,0.85) 0%, rgba(44,75,123,0) 50%); }
  .hn-block-img.warm-left::after  { background: linear-gradient(90deg,  rgba(248,152,116,0.85) 0%, rgba(248,152,116,0) 50%); }
  .hn-block-img.warm-right::after { background: linear-gradient(270deg, rgba(248,152,116,0.85) 0%, rgba(248,152,116,0) 50%); }
  .hn-block-text h2 { color: var(--blue-deep); font-size: clamp(24px,2.6vw,34px); line-height: 1.2; margin: 0 0 20px; }
  .hn-block-text p { font-size: clamp(16px,1.4vw,18px); color: var(--ink-soft); line-height: 1.7; margin: 0 0 16px; }
  .hn-block-text p:last-child { margin-bottom: 0; }
  .hn-feature-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 18px; }
  .hn-feature-list li { display: flex; flex-direction: column; gap: 4px; padding-left: 26px; position: relative; }
  .hn-feature-list li::before { content: '✦'; position: absolute; left: 0; top: 2px; color: var(--orange); }
  .hn-feature-list strong { color: var(--blue-deep); font-size: clamp(16px,1.4vw,18px); }
  .hn-feature-list span { color: var(--ink-soft); font-size: clamp(15px,1.3vw,17px); line-height: 1.6; }

  /* ── LEISTUNGEN ───────────────────────────────────────────── */
  /* padding-top statt 0: die TidalWave oben bringt (anders als die frühere Linie) keinen eigenen Fluss-Abstand mehr mit. */
  .hn-leistungen { background: var(--bg-white); padding-top: clamp(64px, 8vw, 96px); padding-bottom: clamp(60px,8vw,100px); }
  .hn-leistungen h2 { color: var(--blue-deep); font-size: clamp(24px,2.8vw,36px); line-height: 1.2; margin: clamp(48px,7vw,88px) 0 36px; }
  .hn-facts { list-style: none; margin: 0 auto; padding: 0; max-width: 640px; display: grid; gap: 12px; }
  .hn-facts li { position: relative; padding: 16px 20px 16px 56px; border-radius: var(--radius-card); background: var(--bg-cream); box-shadow: var(--shadow-soft); font-size: clamp(15px,1.3vw,17px); color: var(--ink-soft); line-height: 1.5; }
  .hn-facts li::before { content: '✓'; position: absolute; left: 22px; top: 50%; transform: translateY(-50%); color: var(--orange); font-weight: 700; font-size: 18px; }

  /* ── PREISE ───────────────────────────────────────────────── */
  .hn-preise { background: var(--bg-cream); padding: clamp(64px,8vw,110px) 0; }
