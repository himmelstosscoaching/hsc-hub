---
// V2.1 — schlanke Welcome-Seite (7 Sektionen statt 11)
// Neu: Hero mit Paarfoto · gekürzte About/Pillars/Stories/Final
// Weggelassen: Approach (→ /angebote), Hinweise (→ /angebote)
// /fokus bleibt als alte Version erhalten.
import FokusLayout from '../layouts/FokusLayout.astro';
import HeaderFokus from '../components/HeaderFokus.astro';
import HeroFokus2 from '../components/HeroFokus2.astro';
import RecognizeFokus from '../components/RecognizeFokus.astro';
import ManifestoFokus from '../components/ManifestoFokus.astro';
import AboutFokus2 from '../components/AboutFokus2.astro';
import PillarsFokus2 from '../components/PillarsFokus2.astro';
import TwoWaysFokus2 from '../components/TwoWaysFokus2.astro';
import StoriesFokus2 from '../components/StoriesFokus2.astro';
import TrustBookFokus from '../components/TrustBookFokus.astro';
import FinalFokus2 from '../components/FinalFokus2.astro';
import FooterFokus from '../components/FooterFokus.astro';
import PhotoBand from '../components/PhotoBand.astro';
---

<FokusLayout
  title="Annette & Herbert Himmelstoß — wir geben nur weiter, was wir selbst leben"
  description="Dein Leben spricht zu dir. Wir helfen dir, es zu lesen. Annette & Herbert Himmelstoß — seit 1992 ein Paar, Paar- und Life-Coaching."
  canonical="https://himmelstosscoaching.de/"
>
  <HeaderFokus />
  <HeroFokus2 />
  <RecognizeFokus />
  <ManifestoFokus />
  <AboutFokus2 />
  <PillarsFokus2 />
  <TwoWaysFokus2 />
  <PhotoBand
    image="/img/paar-balkon.jpg"
    alt="Annette und Herbert auf dem blauen Balkon ihres Hauses am Meer"
    side="right"
    bg="white"
    quote="Und plötzlich entdeckt ihr wieder, warum ihr euch einmal gewählt habt."
  />
  <StoriesFokus2 />
  <TrustBookFokus />
  <section class="strand-breather">
    <figure>
      <img src="/img/paar-strand.jpg" alt="Annette und Herbert eng beieinander am Strand, beide lachen" loading="lazy" />
    </figure>
  </section>
  <FinalFokus2 />
  <FooterFokus />
</FokusLayout>

<style>
  /* Strand-Stimmungsbild (IMG_9167) — kleines, warmes Abschiedsbild vor dem Schluss-Aufruf. */
  .strand-breather { background: var(--bg-white); padding: clamp(48px, 7vw, 84px) 0 clamp(40px, 6vw, 64px); }
  .strand-breather figure { margin: 0 auto; max-width: 340px; padding: 0 24px; }
  .strand-breather img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    box-shadow: 0 14px 34px rgba(44, 75, 123, 0.14);
    display: block;
  }
</style>
