---
// Dünnes, wellenförmiges Band mit dem Sun-Strip-Verlauf (Blau→Türkis→Orange→Rosé) —
// ersetzt eine gerade Akzentlinie 1:1, nur in Wellenform statt gerade.
// Wie TidalWave: CSS-Verlaufshintergrund + SVG-<mask> (objectBoundingBox → skaliert responsiv),
// dazu Rand-Fade + reduzierte Deckkraft, damit keine harten Farbkanten/-blöcke entstehen
// (reiner Balken-Fill hätte sonst z.B. einen harten Blau-Streifen am linken Rand erzeugt).
// ⚠️ Farbstopps unten sind eine Kopie von --sun-strip (brand-v02.css), plus eine pastellige
// Apricot-Brücke bei ~54% (der direkte Sprung Türkis→Orange erzeugt sonst einen schmutzigen
// Zwischenton). Bei Änderung an --sun-strip hier nachziehen.
interface Props { flip?: boolean }
const { flip = false } = Astro.props;

const maskId = `sunstrip-mask-${Math.random().toString(36).slice(2, 9)}`;
---

<div class={`sunstrip-wave${flip ? ' flip' : ''}`} aria-hidden="true">
  <svg width="0" height="0" style="position:absolute">
    <defs>
      <mask id={maskId} maskContentUnits="objectBoundingBox" maskUnits="objectBoundingBox">
        <path
          d="M0,0.4571 C0.1528,0.9714 0.2778,0.0571 0.5,0.4286 C0.7222,0.8 0.8472,0 1,0.4 L1,1 L0,1 Z"
          fill="#fff"
        />
      </mask>
    </defs>
  </svg>
  <div class="sunstrip-wave-fill" style={`mask: url(#${maskId}); -webkit-mask: url(#${maskId});`}></div>
</div>

<style>
  .sunstrip-wave {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px; /* Sub-Pixel-Lücken schließen */
    line-height: 0;
    pointer-events: none;
    z-index: 2;
  }
  .sunstrip-wave-fill {
    width: 100%;
    height: clamp(10px, 1.6vw, 16px);
    opacity: 0.7;
    background:
      linear-gradient(90deg, #fff 0%, rgba(255,255,255,0) 14%, rgba(255,255,255,0) 86%, #fff 100%),
      linear-gradient(90deg,
        #2C4B7B 0%,
        #3D7AAB 18%,
        #75BFDA 38%,
        #F7C9A0 54%,
        #FA9D56 72%,
        #F89489 100%
      );
  }
  .sunstrip-wave.flip .sunstrip-wave-fill { transform: scaleY(-1); }
</style>
