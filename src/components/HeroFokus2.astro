---
// Hero V2.1 — Vollbild-Paarfoto (Sonnenuntergang) mit Text-Overlay links
// Bild: hero-paar-sonnenuntergang.jpg (A&H am Meer, Blau→Orange→Lachs-Verlauf im Bild)
---

<section class="hero2">
  <img class="hero2-bg" src="/img/hero-paar-sonnenuntergang.jpg" alt="Annette und Herbert Himmelstoß am Meer im Sonnenuntergang" loading="eager" />
  <div class="hero2-veil" aria-hidden="true"></div>

  <div class="container hero2-inner">
    <div class="hero2-text">
      <p class="hero2-eyebrow">Schön, dass du da bist.</p>
      <h1>
        <span class="hl-promise">Das Leben ist immer für&nbsp;dich.</span>
        <span class="hl-aside">Auch wenn es sich gerade nicht so anfühlt.</span>
        <span class="hl-invite">Lern, dein Leben zu lesen.</span>
      </h1>
      <p class="hero2-sub">
        <span class="hero2-name">Annette &amp; Herbert Himmelstoß</span>
        <span class="hero2-cat">Paar- und Life-Coaching</span>
        <span class="hero2-claim">Wir geben nur weiter, was wir selbst leben.</span>
      </p>
      <div class="hero2-ctas">
        <a href="#wer-wir-sind" class="btn btn-primary">Lern uns kennen</a>
        <a href="/angebote" class="hero2-link">Angebote ansehen <span class="arrow">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero2 {
    position: relative;
    min-height: clamp(500px, 64vh, 660px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero2-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%; /* ganzes Bild breit sichtbar → Paar rechts, Köpfe im Bild */
    /* „Ken-Burns" — sehr langsames, kaum merkliches Heranzoomen. Belebt das Standbild.
       Bei „reduzierte Bewegung“ (System-Einstellung) ausgeschaltet. */
    transform-origin: 65% 42%;
    animation: heroKenBurns 26s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes heroKenBurns {
    from { transform: scale(1); }
    to   { transform: scale(1.07); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero2-bg { animation: none; }
  }
  /* Verschleierung links für Text-Lesbarkeit — kräftiger & bis Bildmitte */
  .hero2-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg,
        rgba(20, 86, 122, 0.92) 0%,
        rgba(24, 105, 150, 0.66) 28%,
        rgba(39, 131, 172, 0.30) 46%,
        rgba(39, 131, 172, 0.06) 58%,
        rgba(39, 131, 172, 0) 68%);
  }
  .hero2-inner { position: relative; z-index: 2; width: 100%; }
  .hero2-text { max-width: 560px; margin-top: -64px; }

  .hero2-eyebrow {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(17px, 1.5vw, 21px);
    color: #fff;
    opacity: 0.9;
    margin: 0 0 16px;
  }
  .hero2 h1 {
    color: #fff;
    margin: 0 0 24px;
    text-shadow: 0 2px 24px rgba(20, 35, 60, 0.35);
  }
  /* 1. Versprechen — groß, der Anker */
  .hero2 h1 .hl-promise {
    display: block;
    font-size: clamp(36px, 4.8vw, 60px);
    font-weight: 700;
    line-height: 1.08;
  }
  /* 2. Zwischenton — kleiner, leiser, tröstend */
  .hero2 h1 .hl-aside {
    display: block;
    margin-top: 14px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(18px, 1.9vw, 25px);
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.82);
  }
  /* 3. Einladung — orange, die Handlung */
  .hero2 h1 .hl-invite {
    display: block;
    margin-top: 20px;
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--orange);
    text-shadow: 0 2px 18px rgba(20, 35, 60, 0.3);
  }
  .hero2-sub {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.6;
    color: rgba(255,255,255,0.94);
    margin: 0 0 64px;
  }
  .hero2-name {
    display: block;
    font-size: clamp(16px, 1.4vw, 19px);
    color: rgba(255,255,255,0.92);
  }
  .hero2-cat {
    display: block;
    margin-top: 6px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.1;
    color: var(--orange);
    text-shadow: 0 2px 18px rgba(20, 35, 60, 0.3);
  }
  .hero2-claim {
    display: block;
    margin-top: 10px;
    font-family: var(--font-display);
    font-style: italic;
    color: #fff;
    font-size: 1.1em;
  }
  .hero2-ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
  }
  .hero2-link {
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-bottom: 1.5px solid rgba(255,255,255,0.5);
    padding-bottom: 3px;
    transition: border-color .25s var(--ease);
  }
  .hero2-link:hover { border-bottom-color: #fff; text-decoration: none; }
  .hero2-link .arrow { transition: transform .25s var(--ease); display: inline-block; }
  .hero2-link:hover .arrow { transform: translateX(4px); }

  /* ── Handy: Bild und Text UNTEREINANDER statt übereinander ──────────────
     Grund: Das Foto ist ein Panorama (1920×861). Im hochkanten Handy-Hero
     blieben davon nur ~26 % der Bildbreite sichtbar — und der Textblock lag
     auf 81 % der Höhe, also mitten auf uns beiden. Gestapelt bekommt das Foto
     ein eigenes, breites Format, der Text eine eigene Farbfläche. */
  @media (max-width: 860px) {
    .hero2 {
      display: block;
      min-height: 0;
      overflow: visible;
      padding: 0;   /* globale Sektions-Polsterung hier weg: Foto sitzt direkt unterm Header */
    }
    /* Foto als eigener Block. 3:2 zeigt ~67 % der Bildbreite —
       Sonne links und wir beide rechts sind zusammen drin. */
    .hero2-bg {
      position: static;
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      object-position: 82% center;
      animation: none;   /* auf dem Handy ruhig: kein Ken-Burns */
      display: block;
    }
    /* Kein Schleier mehr — es liegt ja nichts mehr auf dem Foto. */
    .hero2-veil { display: none; }

    /* Textfläche im dunkelsten Ton DIESES Fotos (#134255 — das Tiefteal des
       Himmels oben links, aus dem Bild ausgelesen). Dadurch wirkt die Fläche
       wie eine Fortsetzung des Fotos statt wie ein fremder Farbblock.
       Kontrast: Weiß 10,9:1 · Orange 5,2:1 — beides klar lesbar.
       Unten schließt der Sun-Strip als Kante zur cremefarbenen Sektion ab. */
    .hero2-inner {
      background:
        linear-gradient(90deg,
          #2C4B7B 0%, #3D7AAB 18%, #75BFDA 38%, #FA9D56 70%, #F89489 100%)
          bottom / 100% 6px no-repeat,
        linear-gradient(180deg, #0F3646 0%, #134255 48%, #1A5468 100%);
      padding-top: 26px;
      padding-bottom: 34px;
      /* weicher Übergang: die Fläche haucht nach oben aufs Foto */
      box-shadow: 0 -20px 26px -12px rgba(15, 54, 70, 0.8);
    }
    .hero2-text {
      max-width: 640px;   /* Handy: wirkungslos; Tablet: hält die Zeilen lesbar kurz */
      margin-top: 0;      /* Desktop-Hochschiebung (−64px) hier zurücknehmen */
    }
    /* Ohne Foto im Rücken braucht nichts mehr einen Schlagschatten,
       und die Abstände dürfen enger stehen als auf dem Desktop. */
    .hero2-eyebrow { margin-bottom: 10px; }
    .hero2 h1 { margin-bottom: 18px; text-shadow: none; }
    .hero2 h1 .hl-aside { margin-top: 10px; }
    .hero2 h1 .hl-invite { margin-top: 16px; text-shadow: none; }
    .hero2-sub { margin-bottom: 24px; }
    .hero2-cat { text-shadow: none; }
    .hero2-ctas { gap: 14px 20px; }
  }
</style>
