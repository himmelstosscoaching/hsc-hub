---
// Hero V2.1 — Vollbild-Paarfoto (Sonnenuntergang) mit Text-Overlay links
// Bild: hero-paar-sonnenuntergang.jpg (A&H am Meer, Blau→Orange→Lachs-Verlauf im Bild)
---

<section class="hero2">
  <img class="hero2-bg" src="/img/hero-paar-sonnenuntergang.jpg" alt="Annette und Herbert Himmelstoß am Meer im Sonnenuntergang" loading="eager" />
  <div class="hero2-veil" aria-hidden="true"></div>

  <div class="container hero2-inner">
    <div class="hero2-text">
      <p class="hero2-eyebrow">Schön, dass du da bist.</p>
      <h1>
        Dein Leben spricht zu&nbsp;dir.<br>
        <em>Wir helfen dir, es zu lesen.</em>
      </h1>
      <p class="hero2-sub">
        Annette &amp; Herbert Himmelstoß<br>
        Paar- und Life-Coaching.
        <span class="hero2-claim">Wir geben nur weiter, was wir selbst leben.</span>
      </p>
      <div class="hero2-ctas">
        <a href="#wer-wir-sind" class="btn btn-primary">Lern uns kennen</a>
        <a href="/angebote" class="hero2-link">Angebote ansehen <span class="arrow">→</span></a>
      </div>
    </div>
  </div>

  <div class="sun-divider thick" aria-hidden="true"></div>
</section>

<style>
  .hero2 {
    position: relative;
    min-height: clamp(500px, 64vh, 660px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero2-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%; /* ganzes Bild breit sichtbar → Paar rechts, Köpfe im Bild */
  }
  /* Verschleierung links für Text-Lesbarkeit — kräftiger & bis Bildmitte */
  .hero2-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg,
        rgba(28, 52, 92, 0.85) 0%,
        rgba(28, 52, 92, 0.7) 26%,
        rgba(28, 52, 92, 0.35) 44%,
        rgba(28, 52, 92, 0.05) 56%,
        rgba(28, 52, 92, 0) 66%);
  }
  .hero2-inner { position: relative; z-index: 2; width: 100%; }
  .hero2-text { max-width: 460px; }

  .hero2-eyebrow {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(17px, 1.5vw, 21px);
    color: #fff;
    opacity: 0.9;
    margin: 0 0 16px;
  }
  .hero2 h1 {
    color: #fff;
    font-size: clamp(36px, 4.8vw, 62px);
    line-height: 1.12;
    margin: 0 0 24px;
    text-shadow: 0 2px 24px rgba(20, 35, 60, 0.35);
  }
  .hero2 h1 em {
    font-style: italic;
    color: #ffd9c2;
    font-weight: 400;
  }
  .hero2-sub {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.6;
    color: rgba(255,255,255,0.94);
    margin: 0 0 32px;
  }
  .hero2-claim {
    display: block;
    margin-top: 10px;
    font-family: var(--font-display);
    font-style: italic;
    color: #fff;
    font-size: 1.1em;
  }
  .hero2-ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
  }
  .hero2-link {
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-bottom: 1.5px solid rgba(255,255,255,0.5);
    padding-bottom: 3px;
    transition: border-color .25s var(--ease);
  }
  .hero2-link:hover { border-bottom-color: #fff; text-decoration: none; }
  .hero2-link .arrow { transition: transform .25s var(--ease); display: inline-block; }
  .hero2-link:hover .arrow { transform: translateX(4px); }

  .hero2 .sun-divider { position: absolute; bottom: 0; left: 0; right: 0; }

  @media (max-width: 760px) {
    .hero2 { min-height: 600px; align-items: flex-end; }
    .hero2-bg { object-position: 70% top; }
    .hero2-veil {
      background: linear-gradient(180deg,
        rgba(28,52,92,0.15) 0%,
        rgba(28,52,92,0.35) 45%,
        rgba(28,52,92,0.82) 100%);
    }
    .hero2-inner { padding-bottom: 60px; }
    .hero2-text { max-width: 100%; }
  }
</style>
