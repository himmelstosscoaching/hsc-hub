---
// Hero-Variante B — Panorama HP3A4271 (Paar auf Balkon, Bougainvillea, blauer Himmel)
// Text unten-links über Tiefblau-Verlauf für Kontrast
---

<section class="heropano">
  <img class="heropano-bg" src="/img/pachy-balkon-pano.jpg" alt="Annette und Herbert auf dem Balkon in Pachyammos" loading="eager" />
  <div class="heropano-veil" aria-hidden="true"></div>

  <div class="container heropano-inner">
    <div class="heropano-text">
      <p class="heropano-eyebrow">Schön, dass du da bist.</p>
      <h1>
        Dein Leben spricht zu&nbsp;dir.<br>
        <em>Wir helfen dir, es zu lesen.</em>
      </h1>
      <p class="heropano-sub">
        Annette &amp; Herbert Himmelstoß — Paar- und Life-Coaching.
        <span class="heropano-claim">Wir geben nur weiter, was wir selbst leben.</span>
      </p>
      <div class="heropano-ctas">
        <a href="#wer-wir-sind" class="btn btn-primary">Lern uns kennen</a>
        <a href="/angebote" class="heropano-link">Angebote ansehen <span class="arrow">→</span></a>
      </div>
    </div>
  </div>

  <div class="sun-divider thick" aria-hidden="true"></div>
</section>

<style>
  .heropano {
    position: relative;
    min-height: clamp(560px, 86vh, 860px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .heropano-bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  /* Verlauf von unten + links für Textkontrast */
  .heropano-veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(28,52,92,0) 35%, rgba(28,52,92,0.35) 68%, rgba(28,52,92,0.85) 100%),
      linear-gradient(90deg, rgba(28,52,92,0.55) 0%, rgba(28,52,92,0.1) 45%, rgba(28,52,92,0) 70%);
  }
  .heropano-inner { position: relative; z-index: 2; width: 100%; padding-bottom: clamp(48px, 7vw, 90px); }
  .heropano-text { max-width: 480px; }

  .heropano-eyebrow {
    font-family: var(--font-display); font-style: italic;
    font-size: clamp(17px, 1.5vw, 21px); color: #fff; opacity: 0.92; margin: 0 0 14px;
  }
  .heropano h1 {
    color: #fff; font-size: clamp(34px, 4.6vw, 60px); line-height: 1.12; margin: 0 0 22px;
    text-shadow: 0 2px 24px rgba(20,35,60,0.4);
  }
  .heropano h1 em { font-style: italic; color: #ffd9c2; font-weight: 400; }
  .heropano-sub { font-family: var(--font-body); font-size: clamp(16px, 1.5vw, 20px); line-height: 1.6; color: rgba(255,255,255,0.94); margin: 0 0 30px; }
  .heropano-claim { display: block; margin-top: 10px; font-family: var(--font-display); font-style: italic; color: #fff; font-size: 1.1em; }
  .heropano-ctas { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; }
  .heropano-link { color: #fff; font-family: var(--font-body); font-weight: 600; font-size: 14px; text-decoration: none; border-bottom: 1.5px solid rgba(255,255,255,0.5); padding-bottom: 3px; }
  .heropano-link:hover { border-bottom-color: #fff; text-decoration: none; }
  .heropano-link .arrow { display: inline-block; transition: transform .25s var(--ease); }
  .heropano-link:hover .arrow { transform: translateX(4px); }
  .heropano .sun-divider { position: absolute; bottom: 0; left: 0; right: 0; }

  @media (max-width: 760px) {
    .heropano { min-height: 600px; }
    .heropano-text { max-width: 100%; }
  }
</style>
