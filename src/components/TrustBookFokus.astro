---
// Sektion D — Trust-Streifen
// Quelle: hsc-website/03-Inhalte/01-Startseite-Texte-V01.md (Sektion D)
// Bilder/Cover-Slot raus auf User-Wunsch
import TidalWave from './TidalWave.astro';
---

<section id="trust" class="trust-fokus">
  <TidalWave top />
  <div class="container narrow">
    <ul class="stats" aria-label="Was uns trägt">
      <li><span class="stat-num">seit 1992</span><span class="stat-label">ein Paar</span></li>
      <li><span class="stat-num"><span class="stat-count" data-count-to="20">0</span> Jahre</span><span class="stat-label">Privatarztpraxis</span></li>
      <li><span class="stat-num"><span class="stat-count" data-count-to="20">0</span>.000+</span><span class="stat-label">Menschen begleitet</span></li>
      <li><span class="stat-num"><span class="stat-count" data-count-to="20">0</span>+</span><span class="stat-label">Kongresse</span></li>
      <li><span class="stat-num">Bestseller</span><span class="stat-label">Amazon, mehrere Kategorien</span></li>
    </ul>

    <div class="book-block">
      <h2 class="book-heading">Unser Bestsellerbuch</h2>
      <p class="book-eyebrow">Partnerschaft als Turbo in der eigenen Entwicklung</p>
      <img class="book-cover" src="/img/buch-mockup-vorn-hinten.png" alt="Buch von Annette und Herbert Himmelstoß — Vorder- und Rückseite" loading="lazy" />
      <h3 class="book-title">Die Macht zu bekommen, was<br>beide wollen</h3>
      <p class="book-from">aus unserem Buch „Trau keinem, der nicht in einer glücklichen Beziehung ist"</p>
      <p class="book-desc">Unsere Sicht auf Partnerschaft, Krise und das, was beide tragen kann.</p>
      <a href="/buch" class="btn-link">Mehr zum Buch <span class="arrow">→</span></a>
    </div>

    <p class="voices-eyebrow">Stimmen von Menschen, die wir begleitet haben</p>
    <div class="voices">
      <blockquote>
        „Vom Nebeneinanderher-Leben und Funktionieren wieder zur Wahrnehmung als Ehe- und Liebespaar — trotz aller Alltagsherausforderungen."
        <cite>— Yvonne &amp; Ralf Koller · Paar-Coaching</cite>
      </blockquote>
      <blockquote>
        „Meine schönste Erkenntnis war, noch einmal an das wertfreie Zuhören erinnert zu werden — und die Leichtigkeit eurer Partnerschaft zu spüren."
        <cite>— Sarah Eichbaum · Paar-Coaching</cite>
      </blockquote>
      <blockquote>
        „Ich erlebe mich viel freier in meinem Handeln und in meinem Leben — an vielen Stellen spüre ich schon keine angezogene Handbremse mehr."
        <cite>— Veronika Sudhoff · Einzelcoaching</cite>
      </blockquote>
      <blockquote>
        „Ich konnte all die alten Verletzungen ablegen und der früheren Kollegin wie neu begegnen. Ein Wunder!"
        <cite>— Ritha Elmiger</cite>
      </blockquote>
      <blockquote>
        „Wir leben heute ehrlicher, wahrhaftiger, näher zueinander."
        <cite>— Heike &amp; Frank · Paar-Coaching</cite>
      </blockquote>
      <blockquote>
        „Es ist wie ein zweites Verlieben."
        <cite>— Armin · Paar-Coaching</cite>
      </blockquote>
    </div>
  </div>
</section>

<script>
  // Kennzahlen zählen beim Scrollen hoch — respektiert prefers-reduced-motion.
  const counts = document.querySelectorAll<HTMLElement>('.trust-fokus .stat-count');
  if (counts.length) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const animate = (el: HTMLElement) => {
      const target = Number(el.dataset.countTo || '0');
      if (reduce) { el.textContent = String(target); return; }
      const duration = 1300;
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3); // ease-out
        el.textContent = String(Math.round(target * eased));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });
    counts.forEach((n) => io.observe(n));
  }
</script>

<style>
  .trust-fokus {
    background: var(--bg-white);
    /* padding-top eigens gesetzt: Platz für die breite TidalWave oben, aber ohne den
       vollen Standard-Sektionsabstand (bis 160px), der die Lücke über „seit 1992" sonst sprengt. */
    padding-top: clamp(184px, 10vw, 220px);
    padding-bottom: clamp(80px, 10vw, 130px);
  }
  .stats {
    list-style: none;
    margin: 0 auto 128px;
    padding: 0;
    max-width: 900px;
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: clamp(24px, 4vw, 48px);
  }
  .stats li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 0;
  }
  .stat-num { white-space: nowrap; }
  @media (min-width: 721px) {
    .stats {
      width: 100vw;
      position: relative;
      left: 50%;
      transform: translateX(-50%);
    }
  }
  .stat-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.1;
    color: var(--orange);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    margin-top: 6px;
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }
  .book-block {
    text-align: center;
    margin: 0 auto 80px;
    max-width: 640px;
  }
  .book-cover {
    width: 100%;
    max-width: 420px;
    height: auto;
    margin: 0 auto 57px;
    display: block;
  }
  .book-heading {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.2;
    color: var(--blue-deep);
    margin: 0 0 14px;
  }
  .book-eyebrow {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.35;
    color: var(--blue-deep);
    margin: 0 0 57px;
  }
  .book-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(26px, 2.7vw, 36px);
    line-height: 1.2;
    color: var(--blue-deep);
    margin: 0 0 10px;
  }
  .book-from {
    font-family: var(--font-body);
    font-size: 16px;
    letter-spacing: 0.01em;
    color: var(--ink-light);
    margin: 0 0 14px;
  }
  .book-desc {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 18px;
    margin: 0 0 22px;
  }
  .book-block .btn-link { font-size: 18px; }

  .voices-eyebrow {
    text-align: center;
    font-family: var(--font-body);
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--orange);
    margin: 0 auto 28px;
  }
  .voices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    max-width: 760px;
    margin: 0 auto;
  }
  .voices blockquote {
    margin: 0;
    padding: 0 0 0 24px;
    border-left: 2px solid var(--rose);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--blue-deep);
  }
  .voices cite {
    display: block;
    margin-top: 10px;
    font-family: var(--font-body);
    font-style: normal;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ink-light);
  }

  @media (max-width: 720px) {
    .voices { grid-template-columns: 1fr; gap: 24px; }
    .stats { flex-wrap: wrap; gap: clamp(20px, 5vw, 32px); }
    .stats li { min-width: 120px; }
  }
</style>
