---
// Sektion „Erkennst du dich?" — Identifikations-Block zwischen Hero und About
// Vier ruhige Statements aus der Lebenswelt der Zielgruppe (Einzelne + Paare)
// Übergangs-Satz schließt die Brücke ins About
// Oben bewusst gerade (direkt unters Startbild gesetzt wirkte eine Welle dort unvermittelt) —
// unten ist das Creme-Feld selbst gewellt (clip-path) statt einer aufgelegten Wellen-Grafik.
const clipId = `recognize-curve-${Math.random().toString(36).slice(2, 9)}`;
---

<section id="erkennst-du-dich" class="recognize-fokus" style={`clip-path: url(#${clipId});`}>
  <svg width="0" height="0" style="position:absolute">
    <clipPath id={clipId} clipPathUnits="objectBoundingBox">
      <path d="M0,0 L1,0 L1,0.972
               C0.847,1 0.722,0.944 0.5,0.970 C0.278,0.996 0.153,0.932 0,0.968 Z" />
    </clipPath>
  </svg>
  <div class="container narrow section-head">
    <h2>Erkennst du dich?</h2>
  </div>

  <div class="container narrow recognize-list">
    <p class="recognize-line reveal-on-scroll">
      Du fragst dich, wer du sein willst —<br>
      nicht, wer du für andere sein sollst.
    </p>

    <p class="recognize-line reveal-on-scroll">
      Ihr streitet immer über die gleichen Themen —<br>
      und dreht euch dabei im Kreis.
    </p>

    <p class="recognize-line reveal-on-scroll">
      Eine Krankheit, eine Sorge, ein Konflikt —<br>
      kommt zurück. Wieder. Und wieder.
    </p>

    <p class="recognize-line reveal-on-scroll">
      Du spürst: in deinem Leben fehlt etwas.<br>
      Aber du weißt nicht, was.
    </p>
  </div>

  <div class="container narrow recognize-foot">
    <p>
      Wir kennen diese Themen. <em>Aus dem eigenen Leben.</em>
    </p>
  </div>
</section>

<style>
  .recognize-fokus {
    /* Oranger Akzent unten direkt im Hintergrund (statt aufgelegter Welle) — schmal und
       leicht transparent, markiert die gewellte Unterkante ohne klobig zu wirken. */
    background:
      linear-gradient(0deg, color-mix(in srgb, var(--orange) 65%, transparent) 0, transparent 32px),
      var(--bg-cream);
    padding-top: clamp(76px, 5vw, 96px);
    padding-bottom: clamp(76px, 5vw, 96px);
  }
  .section-head {
    text-align: center;
    margin-bottom: clamp(28px, 4vw, 40px);
  }
  .section-head h2 {
    color: var(--blue-deep);
    margin: 0;
    font-weight: 600;
  }

  .recognize-list {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.6vw, 32px);
    text-align: center;
  }
  .recognize-line {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(17px, 1.8vw, 24px);
    line-height: 1.35;
    color: var(--blue-deep);
    margin: 0;
    letter-spacing: -0.005em;
  }

  .recognize-foot {
    margin-top: clamp(30px, 4vw, 46px);
    padding-top: 26px;
    border-top: 1px solid rgba(184, 149, 107, 0.3);
    text-align: center;
  }
  .recognize-foot p {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
    max-width: 620px;
    margin: 0 auto;
  }
  .recognize-foot em {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--rose);
  }

  @media (max-width: 720px) {
    .recognize-line br { display: none; }
  }
</style>
