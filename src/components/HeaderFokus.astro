---
// Ruhiger Header mit Logo + Anker-Menü
// home = Ziel der Welcome-Seite (Logo + Anker). Default / (Startseite);
// die Panorama-Variante übergibt /fokus2b, damit jede Variante bei sich bleibt.
interface Props { home?: string }
const { home = '/' } = Astro.props;

// Menüpunkte einmal definiert → identisch für Desktop-Leiste und Handy-Menü.
const links = [
  { href: `${home}#wer-wir-sind`, label: 'Über uns' },
  { href: `${home}#was-uns-auszeichnet`, label: 'So arbeiten wir mit dir' },
  { href: '/angebote', label: 'Angebote' },
  { href: '/buch', label: 'Buch' },
];
---

<header class="header-fokus">
  <div class="container header-inner">
    <a href={home} class="brand">
      <img src="/img/logo.svg" alt="Himmelstoß Coaching" class="brand-logo" />
    </a>

    <!-- Desktop-Menü -->
    <nav class="nav">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/angebote#frei" class="nav-cta">Kostenlos starten →</a>
    </nav>

    <!-- Handy: Hamburger-Knopf (nur ≤768px sichtbar) -->
    <button
      class="nav-toggle"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <!-- Handy-Menü (aufklappbar). Immer im DOM; per .open-Klasse animiert,
       im geschlossenen Zustand via visibility:hidden aus dem Tab-Fluss. -->
  <nav id="mobile-nav" class="mobile-nav">
    <div class="container mobile-nav-inner">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/angebote#frei" class="mobile-cta">Kostenlos starten →</a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector('.header-fokus');
  const toggle = header?.querySelector('.nav-toggle') as HTMLButtonElement | null;
  const menu = header?.querySelector('#mobile-nav') as HTMLElement | null;

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
      header?.classList.toggle('menu-open', open);
      menu.classList.toggle('open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    // Beim Klick auf einen Menüpunkt schließen
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    // Esc schließt
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
  }
</script>

<style>
  .header-fokus {
    background: var(--bg-white);
    padding: 22px 0;
    border-bottom: 1px solid rgba(184, 149, 107, 0.18);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
    background: rgba(255, 255, 255, 0.96);
  }
  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
  }
  .brand-logo {
    height: 59px;
    width: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .nav a {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color .2s var(--ease);
  }
  .nav a:hover {
    color: var(--blue-deep);
    text-decoration: none;
  }
  .nav-cta {
    color: var(--blue-deep) !important;
    font-weight: 600;
  }

  /* ── Hamburger-Knopf ── */
  .nav-toggle {
    display: none;               /* Desktop: aus */
    background: none;
    border: none;
    padding: 8px;
    margin: -8px;                /* größere Tap-Fläche ohne Layout-Verschiebung */
    cursor: pointer;
    color: var(--blue-deep);
    line-height: 0;
  }
  .nav-toggle-bars,
  .nav-toggle-bars > span {
    display: block;
  }
  .nav-toggle-bars {
    position: relative;
    width: 26px;
    height: 18px;
  }
  .nav-toggle-bars > span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform .28s var(--ease), opacity .2s var(--ease), top .28s var(--ease);
  }
  .nav-toggle-bars > span:nth-child(1) { top: 0; }
  .nav-toggle-bars > span:nth-child(2) { top: 8px; }
  .nav-toggle-bars > span:nth-child(3) { top: 16px; }
  /* offen → X */
  .menu-open .nav-toggle-bars > span:nth-child(1) { top: 8px; transform: rotate(45deg); }
  .menu-open .nav-toggle-bars > span:nth-child(2) { opacity: 0; }
  .menu-open .nav-toggle-bars > span:nth-child(3) { top: 8px; transform: rotate(-45deg); }

  /* ── Handy-Menü ── */
  .mobile-nav {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    visibility: hidden;               /* geschlossen: nicht per Tab erreichbar */
    border-top: 1px solid rgba(184, 149, 107, 0);
    background: rgba(255, 255, 255, 0.98);
    transition: max-height .28s var(--ease), opacity .22s var(--ease),
                border-color .28s var(--ease), visibility 0s linear .28s;
  }
  .mobile-nav.open {
    max-height: 340px;
    opacity: 1;
    visibility: visible;
    border-top-color: rgba(184, 149, 107, 0.18);
    transition: max-height .28s var(--ease), opacity .22s var(--ease),
                border-color .28s var(--ease), visibility 0s linear 0s;
  }
  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 0 18px;
  }
  .mobile-nav-inner a {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 12px 4px;
    border-bottom: 1px solid rgba(184, 149, 107, 0.12);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .mobile-nav-inner a:hover { color: var(--blue-deep); }
  .mobile-nav-inner .mobile-cta {
    margin-top: 12px;
    border-bottom: none;
    color: #fff;
    background: var(--orange);
    border-radius: var(--radius-pill, 999px);
    justify-content: center;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .nav { display: none; }        /* Desktop-Leiste aus */
    .nav-toggle { display: block; } /* Hamburger an */
  }
</style>
