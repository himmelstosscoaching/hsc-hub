---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<span class="eyebrow">{text}</span>

<style>
  .eyebrow {
    display: inline-block;
    font-family: 'League Spartan', sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 18px;
  }
</style>
