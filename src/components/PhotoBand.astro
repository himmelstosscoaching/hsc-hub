---
// Foto-Band — großes randloses A&H-Foto auf einer Sektionshälfte + Zitat/Text daneben
// Konzept von der alten himmelstosscoaching.de übernommen (große Bilder tauchen immer mal auf)
interface Props {
  image: string;
  alt: string;
  side?: 'left' | 'right';   // auf welcher Seite das Foto sitzt
  bg?: 'cream' | 'white';
  eyebrow?: string;
  quote: string;             // großes Statement (Fontin)
  text?: string;             // optionaler kleiner Begleittext
  compact?: boolean;         // kleineres Foto-Band (niedrigere Höhe)
  author?: string;           // optionale Namensnennung (Kundenstimme)
  uncropped?: boolean;       // Bild komplett zeigen (nicht ins 3:2 beschneiden)
  cropTop?: boolean;         // nur oben beschneiden, unten komplett zeigen
  largeQuote?: boolean;      // im kompakten Modus das Zitat etwas größer lassen
  imageLarge?: boolean;      // im kompakten Modus ein größeres Bild (Einzelfall)
  centerText?: boolean;      // Text zentrieren (statt am Bild-Rand ausgerichtet)
}
const { image, alt, side = 'left', bg = 'cream', eyebrow, quote, text, compact = false, author, uncropped = false, cropTop = false, largeQuote = false, imageLarge = false, centerText = false } = Astro.props;
const bgClass = bg === 'cream' ? 'pb-cream' : 'pb-white';
---

<section class={`photoband ${bgClass} ${side === 'right' ? 'img-right' : 'img-left'}${compact ? ' pb-compact' : ''}${uncropped ? ' pb-img-natural' : ''}${cropTop ? ' pb-crop-top' : ''}${largeQuote ? ' pb-quote-lg' : ''}${imageLarge ? ' pb-img-lg' : ''}${centerText ? ' pb-center' : ''}`}>
  <div class="pb-photo">
    <img src={image} alt={alt} loading="lazy" />
  </div>
  <div class="pb-textwrap">
    <div class="pb-text reveal-on-scroll">
      {eyebrow && <span class="acc-eyebrow">{eyebrow}</span>}
      <p class="pb-quote">{quote}</p>
      {author && <p class="pb-cite">— {author}</p>}
      {text && <p class="pb-body">{text}</p>}
    </div>
  </div>
</section>

<style>
  .photoband {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    min-height: clamp(420px, 52vh, 600px);
    position: relative;
  }
  /* Kompakt: kleines, gerahmtes Foto (statt randlos über die halbe Breite) + kleineres Zitat, kein Leerraum */
  .photoband.pb-compact { min-height: 0; padding: 0; }
  .pb-compact .pb-textwrap { padding: clamp(26px, 3.5vw, 46px); }
  .pb-compact .pb-quote { font-size: clamp(20px, 2.1vw, 27px); line-height: 1.3; }
  .pb-compact.pb-quote-lg .pb-quote { font-size: clamp(22px, 2.6vw, 34px); line-height: 1.3; }
  .pb-compact .pb-photo {
    aspect-ratio: auto;
    align-self: center;
    display: flex;
    justify-content: center;
    padding: clamp(18px, 3vw, 40px);
  }
  .pb-compact .pb-photo img {
    width: clamp(300px, 32vw, 440px);
    max-width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
  }
  /* Größeres Bild (Einzelfall, z.B. Startseite) */
  .pb-compact.pb-img-lg .pb-photo img { width: clamp(360px, 42vw, 620px); }
  /* Text zentrieren (klebt sonst am Bild-Rand) */
  .pb-center .pb-textwrap { justify-content: center; }
  .pb-center .pb-text { text-align: center; }
  .pb-center .acc-eyebrow { justify-content: center; }
  /* Bild 1: komplett im Originalformat (nichts beschneiden) */
  .pb-compact.pb-img-natural .pb-photo img {
    aspect-ratio: auto;
    object-fit: contain;
  }
  /* Bild 2: nur oben beschneiden, unten komplett (Ausschnitt unten verankert) */
  .pb-compact.pb-crop-top .pb-photo img {
    aspect-ratio: 9 / 10;
    object-position: bottom;
  }
  @media (max-width: 820px) {
    .pb-compact .pb-photo img { width: clamp(230px, 62vw, 360px); }
  }
  .pb-cream { background: var(--bg-cream); }
  .pb-white { background: var(--bg-white); }

  .pb-photo { position: relative; overflow: hidden; }
  .pb-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .pb-textwrap { display: flex; align-items: center; padding: clamp(40px, 6vw, 90px); }
  .pb-text { max-width: 480px; }
  .pb-text .acc-eyebrow { font-size: 15px; letter-spacing: 0.16em; margin-bottom: 22px; }
  .pb-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.28;
    color: var(--blue-deep);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .pb-cite {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    margin: 18px 0 0;
  }
  .pb-body {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 22px 0 0;
  }

  /* Foto rechts → Reihenfolge umkehren */
  .img-right .pb-photo { order: 2; }
  .img-right .pb-textwrap { order: 1; justify-content: flex-end; }
  .img-right .pb-text { text-align: right; }
  .img-right .acc-eyebrow { flex-direction: row-reverse; }

  @media (max-width: 820px) {
    .photoband { grid-template-columns: 1fr; min-height: 0; }
    .pb-photo { aspect-ratio: 3 / 2; }
    .img-right .pb-photo { order: -1; }
    .img-right .pb-textwrap { order: 0; justify-content: flex-start; }
    .img-right .pb-text { text-align: left; }
    .img-right .acc-eyebrow { flex-direction: row; }
    .pb-textwrap { padding: clamp(36px, 8vw, 56px) 24px; }
  }
</style>
