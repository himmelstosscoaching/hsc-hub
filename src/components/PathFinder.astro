---
// „Welcher Weg passt zu dir?" — kleiner Klick-Fragebogen (3 Fragen max.), der zum passenden
// Angebot führt. Kein Formular, keine Übertragung — rein clientseitig, JS im <script> unten.
// Wer noch nicht bereit ist zu kaufen, kann bei Frage 2 direkt zu den kostenlosen Einstiegen
// abbiegen (Anschluss an die bestehende #frei-Sektion), statt zu einem Kauf gedrängt zu werden.
---

<section class="pf" id="wegfinder">
  <div class="container narrow">
    <div class="pf-head">
      <span class="acc-eyebrow">In 30 Sekunden</span>
      <h2>Welcher Weg passt zu dir?</h2>
      <p>Ein paar kurze Fragen — und wir zeigen dir, welches Angebot gerade zu deiner Situation passt.</p>
    </div>

    <div class="pf-box" data-pf data-current-step="1">
      <div class="pf-bar">
        <div class="pf-progress" aria-hidden="true">
          <span class="pf-dot is-active" data-dot="1"></span>
          <span class="pf-dot" data-dot="2"></span>
          <span class="pf-dot" data-dot="3"></span>
        </div>
        <button type="button" class="pf-reset-top" data-restart>↺ Von vorne</button>
      </div>

      <div class="pf-step is-active" data-step="1">
        <h3>Wie möchtest du gehen?</h3>
        <div class="pf-options">
          <button type="button" class="pf-opt" data-key="weg" data-value="allein">Allein</button>
          <button type="button" class="pf-opt" data-key="weg" data-value="paar">Als Paar</button>
          <button type="button" class="pf-opt" data-key="weg" data-value="tier">Mit meinem Tier</button>
        </div>
      </div>

      <div class="pf-step" data-step="2">
        <h3>Was brauchst du gerade mehr?</h3>
        <div class="pf-options">
          <button type="button" class="pf-opt" data-key="bedarf" data-value="thema">Ein konkretes Thema lösen</button>
          <button type="button" class="pf-opt" data-key="bedarf" data-value="jahr">Mich über einen längeren Zeitraum neu ausrichten</button>
          <button type="button" class="pf-opt" data-key="bedarf" data-value="retreat">Intensive Zeit am Stück, ganz raus</button>
          <button type="button" class="pf-opt is-subtle" data-key="bedarf" data-value="frei">Ich will erstmal unverbindlich reinschnuppern</button>
        </div>
      </div>

      <div class="pf-step" data-step="3">
        <h3>Wie möchtest du begleitet werden?</h3>
        <div class="pf-options">
          <button type="button" class="pf-opt" data-key="praegung" data-value="kurs">In meinem eigenen Tempo, mit Workbook</button>
          <button type="button" class="pf-opt" data-key="praegung" data-value="community">In fester Gemeinschaft, mit Live-Terminen</button>
        </div>
      </div>

      <div class="pf-step pf-result" data-step="result">
        <p class="pf-result-eyebrow">Unsere Empfehlung für dich</p>
        <h3 data-result-title></h3>
        <p data-result-text></p>
        <div class="pf-result-ctas">
          <a class="btn btn-primary" data-result-link href="#">Mehr erfahren →</a>
          <button type="button" class="pf-restart" data-restart>Noch mal von vorn</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type Answers = { weg?: string; bedarf?: string; praegung?: string };

  const box = document.querySelector<HTMLElement>('[data-pf]');
  if (box) {
    const steps = box.querySelectorAll<HTMLElement>('.pf-step');
    const dots = box.querySelectorAll<HTMLElement>('.pf-dot');
    const answers: Answers = {};

    const showStep = (name: string, dotCount: number) => {
      steps.forEach((s) => s.classList.toggle('is-active', s.dataset.step === name));
      dots.forEach((d) => d.classList.toggle('is-active', Number(d.dataset.dot) <= dotCount));
      box.dataset.currentStep = name;
    };

    const getResult = (a: Answers) => {
      if (a.bedarf === 'frei') {
        return {
          title: 'Kostenlos reinschnuppern',
          text: 'Du musst dich nicht gleich entscheiden — probier erst unsere kostenlosen Impulse aus.',
          href: '#frei',
          cta: 'Zu den kostenlosen Einstiegen →',
        };
      }
      if (a.weg === 'tier') {
        return {
          title: 'Einzelcoaching — mit deinem Tier im Gespräch',
          text: 'Steffi spricht mit deinem Tier — was es zeigt, wird zum Einstieg in deinen Prozess mit Annette.',
          href: '/einzelcoaching#mit-tier',
          cta: 'Mehr erfahren →',
        };
      }
      if (a.bedarf === 'thema') {
        if (a.weg === 'paar') {
          return {
            title: 'Einzelcoaching — als Paar',
            text: 'Ein Thema, das zwischen euch steht — Herbert und Annette begleiten euch gemeinsam.',
            href: '/einzelcoaching#zu-zweit',
            cta: 'Mehr erfahren →',
          };
        }
        return {
          title: 'Einzelcoaching — allein',
          text: 'Ihr löst ein tiefliegendes Muster auf, das dir gerade im Weg steht.',
          href: '/einzelcoaching#allein',
          cta: 'Mehr erfahren →',
        };
      }
      if (a.bedarf === 'retreat') {
        return {
          title: 'Intensiv-Coaching-Woche Zypern',
          text: 'Eine Woche am Meer, die nachwirkt — als Paar oder einzeln.',
          href: '/intensiv-coaching-zypern',
          cta: 'Mehr erfahren →',
        };
      }
      // a.bedarf === 'jahr'
      if (a.praegung === 'community') {
        return {
          title: 'Monatsausrichtung',
          text: 'Jeden Monat neu ausgerichtet, getragen von einer Gemeinschaft.',
          href: '/monatsausrichtung',
          cta: 'Mehr erfahren →',
        };
      }
      if (a.weg === 'paar') {
        return {
          title: 'Schatz, coachst du mich?',
          text: 'Der Kurs, in dem ihr lernt, euch gegenseitig zu coachen — und euch wieder nah zu sein.',
          href: '/schatz',
          cta: 'Mehr erfahren →',
        };
      }
      return {
        title: 'Dein Leben lesen lernen',
        text: 'Lerne, die Hinweise deines Lebens zu lesen — und dir wieder selbst zu vertrauen.',
        href: '/dein-leben-lesen-lernen',
        cta: 'Mehr erfahren →',
      };
    };

    const showResult = () => {
      const r = getResult(answers);
      box.querySelector('[data-result-title]')!.textContent = r.title;
      box.querySelector('[data-result-text]')!.textContent = r.text;
      const link = box.querySelector<HTMLAnchorElement>('[data-result-link]')!;
      link.href = r.href;
      link.textContent = r.cta;
      // Punkte zeigen, wie viele Fragen tatsächlich gestellt wurden (variiert je Pfad).
      const asked = answers.weg === 'tier' ? 1 : answers.bedarf === 'jahr' ? 3 : 2;
      showStep('result', asked);
    };

    box.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.pf-opt');
      if (btn) {
        const key = btn.dataset.key as keyof Answers;
        answers[key] = btn.dataset.value;

        if (key === 'weg') {
          // Mit Tier gibt es nur ein Angebot — keine weiteren Fragen nötig.
          if (answers.weg === 'tier') { showResult(); return; }
          showStep('2', 1);
          return;
        }
        if (key === 'bedarf') {
          if (answers.bedarf === 'jahr') { showStep('3', 2); return; }
          showResult();
          return;
        }
        if (key === 'praegung') { showResult(); return; }
      }

      if ((e.target as HTMLElement).closest('[data-restart]')) {
        answers.weg = undefined;
        answers.bedarf = undefined;
        answers.praegung = undefined;
        showStep('1', 1);
      }
    });
  }
</script>

<style>
  .pf {
    background: var(--bg-cream);
    padding: clamp(56px, 7vw, 90px) 0;
  }
  .pf-head { text-align: center; max-width: 560px; margin: 0 auto clamp(32px, 4vw, 44px); }
  .pf-head .acc-eyebrow { justify-content: center; }
  .pf-head h2 { color: var(--blue-deep); margin: 0 0 12px; }
  .pf-head p { font-size: clamp(16px, 1.4vw, 18px); color: var(--ink-soft); margin: 0; line-height: 1.6; }

  .pf-box {
    max-width: 640px;
    margin: 0 auto;
    background: var(--bg-white);
    border: 1px solid rgba(184, 149, 107, 0.2);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: clamp(32px, 4vw, 48px);
  }

  .pf-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-bottom: 28px;
  }
  .pf-progress { grid-column: 2; display: flex; justify-content: center; gap: 8px; margin-bottom: 0; }
  .pf-reset-top {
    grid-column: 3;
    justify-self: end;
    display: none;
    background: none; border: none; cursor: pointer;
    font-family: var(--font-body); font-size: 12.5px; color: var(--ink-light);
    white-space: nowrap;
  }
  .pf-reset-top:hover { color: var(--blue-deep); }
  /* Nur während der Fragen 2/3 sichtbar — auf Frage 1 gibt es noch nichts zurückzusetzen,
     auf dem Ergebnis übernimmt der eigene „Noch mal von vorn"-Knopf diese Rolle. */
  .pf-box[data-current-step="2"] .pf-reset-top,
  .pf-box[data-current-step="3"] .pf-reset-top { display: inline-block; }

  @media (max-width: 480px) {
    .pf-bar { grid-template-columns: auto 1fr; }
    .pf-progress { grid-column: 1; justify-content: flex-start; }
    .pf-reset-top { grid-column: 2; }
  }
  .pf-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: rgba(44, 75, 123, 0.15);
    transition: background .25s var(--ease);
  }
  .pf-dot.is-active { background: var(--orange); }

  .pf-step { display: none; text-align: center; }
  .pf-step.is-active { display: block; animation: pf-fade .35s var(--ease); }
  @keyframes pf-fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  .pf-step h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(20px, 2vw, 25px);
    color: var(--blue-deep);
    margin: 0 0 22px;
  }

  .pf-options { display: flex; flex-direction: column; gap: 10px; }
  .pf-opt {
    font-family: var(--font-body);
    font-size: 15.5px;
    font-weight: 500;
    color: var(--blue-deep);
    background: var(--bg-cream);
    border: 1.5px solid rgba(44, 75, 123, 0.14);
    border-radius: var(--radius-button);
    padding: 14px 20px;
    cursor: pointer;
    text-align: center;
    transition: border-color .2s var(--ease), background .2s var(--ease), transform .2s var(--ease);
  }
  .pf-opt:hover { border-color: var(--orange); background: #fff; transform: translateY(-1px); }
  .pf-opt.is-subtle { color: var(--ink-soft); font-style: italic; font-size: 14.5px; border-style: dashed; }

  .pf-result-eyebrow {
    font-family: var(--font-body);
    font-size: 12.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--orange); margin: 0 0 10px;
  }
  .pf-result p { font-size: 16px; line-height: 1.6; color: var(--ink-soft); margin: 0 0 26px; }
  .pf-result-ctas { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .pf-restart {
    background: none; border: none; cursor: pointer;
    font-family: var(--font-body); font-size: 13px; color: var(--ink-light);
    text-decoration: underline; text-underline-offset: 3px;
  }
  .pf-restart:hover { color: var(--blue-deep); }

  @media (max-width: 560px) {
    .pf-box { padding: 26px 20px; }
  }
</style>
